// One region's zones, its key `zone:` and the region.
construct TimeZoneRegionRoute(region: String, choices: SettingsChoices) extends NavigationRoute {
    function routeKey() -> String {
        return "zone:" + region
    }

    function destination() -> Any Widget {
        return TimeZoneRegionPane(region = copy region, choices = choices)
    }
}
