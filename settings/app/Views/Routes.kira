import KiraUI

// The panes, one route each: a sidebar row starts the path at one, a row in a
// pane appends one, and the detail's stack draws the pane the path ends at,
// with the bar's back button once it is deeper than the sidebar's row.

construct GeneralRoute(release: Release, choices: SettingsChoices) extends NavigationRoute {
    function routeKey() -> String {
        return "general"
    }

    function destination() -> Any Widget {
        return GeneralPane(release = copy release, choices = choices)
    }
}

construct AboutRoute(release: Release) extends NavigationRoute {
    function routeKey() -> String {
        return "about"
    }

    function destination() -> Any Widget {
        return AboutPane(release = copy release)
    }
}

construct StorageRoute() extends NavigationRoute {
    function routeKey() -> String {
        return "storage"
    }

    function destination() -> Any Widget {
        return StoragePane()
    }
}

