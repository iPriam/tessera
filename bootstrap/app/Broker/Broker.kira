import Foundation
import Heap
import LibTessera

// What the broker does with each request.
//
// `CheckIn` makes the asking connection a service's: the broker keeps it and
// sends every client down it. `System/connectService`, on a client's System
// channel (`System.kira`), makes a channel and hands one end to the client
// in the answer and the other to the service in a `Connection` that names
// the client's program, which is how a service knows who it serves without
// asking about a peer it never accepted. A client that asks for a service
// that has not checked in yet, because it is still starting or is being
// restarted, waits for it, at most `Waiting.patience`: init starts every
// service at once, and a client should not have to know which came up
// first.

// A connection the broker accepted, under the key its waits complete with,
// and the process and program at its other end.
struct Peer {
    let channel: Handle
    let key: Number
    let process: Number
    let program: String?
}

// A client's `connectService`, under its transaction id.
struct ConnectRequest {
    let client: Peer
    let txid: Number
}

// A client waiting for `service` to check in.
struct WaitingClient {
    let request: ConnectRequest
    let service: Number
    let deadline: Number
}

namespace Waiting {
    let patience: Number = 10000000000
}

// Every connection the broker holds, and who is waiting for what.
struct Broker {
    let port: Handle
    var services: [OfferedService]
    // Connections whose first message has not been read.
    var newcomers: [Peer] = []
    var systems: [Peer] = []
    var waiting: [WaitingClient] = []
    var nextKey: Number = PortKey.firstConnection
}

function programName(program: borrow String?) -> String {
    match program {
        Some(path) -> return path
        None -> return "an unknown program"
    }
}

// What a connection's key names.
enum HeldConnection {
    CheckedIn(Number)
    SystemChannel(Number)
    Newcomer(Number)
}

// Which connection `key` names, if the broker still holds it. A free
// function: a method answering an optional of this package's enum is
// refused (3050).
function connectionUnder(broker: borrow Broker, key: Number) -> HeldConnection? {
    for (index, service) in broker.services.enumerated() {
        if service.isCheckedInUnder(key) { return .Some(.CheckedIn(index)) }
    }
    for (index, system) in broker.systems.enumerated() {
        if system.key == key { return .Some(.SystemChannel(index)) }
    }
    for (index, newcomer) in broker.newcomers.enumerated() {
        if newcomer.key == key { return .Some(.Newcomer(index)) }
    }
    return .None
}

// Whether a newcomer stays open as the service it checked in as.
enum NewcomerOutcome {
    Kept
    Refused
}

// Whether a client was handed its channel to a service.
enum Delivery {
    Handed
    // The service had gone; the client is still waiting for one.
    Gone
}

extend Broker {
    // Waits once more for `channel` to read or close, under `key`.
    function arm(borrow self, channel: Handle, key: Number) {
        match objectWaitAsync(channel, Signals.readable | Signals.peerClosed, .Once, port, key) {
            // The connection is watched; the port completes under `key` when it reads or closes.
            Ok -> {}
            Error(failed) -> log warn("cannot wait on a connection", error: errorName(failed))
        }
    }

    // Takes every connection waiting on the listener.
    function acceptAll(borrow mut self, listener: Handle) {
        while true {
            let connection = match brokerAccept(listener) {
                Ok(value) -> value
                Error(failed) -> {
                    if failed.code != .ShouldWait {
                        log warn("cannot accept a connection", error: errorName(failed))
                    }
                    return
                }
            }
            let program: String? = match servicePeerProgram(connection.channel) {
                Ok(path) -> .Some(path)
                Error(failed) -> {
                    log warn("cannot tell which program connected", error: errorName(failed))
                    .None
                }
            }
            let key = nextKey
            nextKey++
            newcomers.append(
                Peer {
                    channel: connection.channel,
                    key: key,
                    process: connection.process,
                    program: program
                }
            )
            arm(connection.channel, key)
        }
    }

    // The connection under `key` has something to read, or has closed.
    function ready(borrow mut self, key: Number) {
        match connectionUnder(self, key) {
            Some(connection) -> {
                match connection {
                    CheckedIn(service) -> readService(service)
                    SystemChannel(index) -> readSystem(index)
                    Newcomer(index) -> greet(index)
                }
            }
            // The connection was closed and forgotten after its wait was armed.
            None -> {}
        }
    }

    function serviceIndex(borrow self, name: borrow String) -> Number? {
        for (index, service) in services.enumerated() {
            if service.name == name { return .Some(index) }
        }
        return .None
    }

    // Reads what a service sent up its check-in connection, then waits for
    // more, or checks it out once it has gone.
    function readService(borrow mut self, service: Number) {
        let checkIn = try services[service].checkIn otherwise return
        if takePosts(service, checkIn.channel) {
            arm(checkIn.channel, checkIn.key)
        } else {
            checkOut(service)
        }
    }

    // Takes every event a service posted; false once it has gone.
    function takePosts(borrow self, service: Number, channel: Handle) -> Bool {
        let blockBytes = zeroedBlock(count: CheckInWire.messageBytes, alignment: 16)
        let block = blockBytes.pointer()
        while true {
            let received = match receiveBrokerMessage(channel, block) {
                Ok(value) -> value
                Error(failed) -> return isStillOpen(failed)
            }
            match received.kind {
                CheckInWire -> {
                    match checkInRequest(block) {
                        Post(event) -> post(service, event)
                        // Once a service has checked in it only posts; a check-in
                        // it sends again means nothing.
                        CheckIn -> {}
                        // A post the wire cannot carry is dropped; the check-in
                        // connection has no reply to send.
                        Malformed -> {}
                        // The connection has no reply for an operation a service
                        // does not send, so it is ignored.
                        Unsupported -> {}
                    }
                }
                // A Channel message on a check-in connection means nothing.
                ChannelMessage -> {}
            }
        }
        return true
    }

    // Whether a service's check-in connection is still open: its process has
    // not exited and closed it. Reading it also takes any event it posted.
    function isCheckedIn(borrow mut self, service: Number) -> Bool {
        let checkIn = try services[service].checkIn otherwise return false
        if takePosts(service, checkIn.channel) { return true }
        checkOut(service)
        return false
    }

    function checkOut(borrow mut self, service: Number) {
        let checkIn = try services[service].checkIn otherwise return
        release(checkIn.channel)
        services[service].checkIn = .None
        log info("a service checked out", service: services[service].name)
    }

    // Hands the client a channel to `service`. `Gone` leaves the client
    // unanswered: the service turned out to have gone, and the client waits
    // for it to come back.
    function deliver(borrow mut self, service: Number, request: borrow ConnectRequest) -> Delivery {
        let checkIn = try services[service].checkIn otherwise return .Gone
        let pair = match channelCreate() {
            Ok(value) -> value
            Error(failed) -> {
                log warn("cannot make a channel for a client", error: errorName(failed))
                // The client is answered with the refusal; nothing is left
                // waiting for the service.
                refuseConnect(request, .Internal)
                return .Handed
            }
        }
        match sendConnection(checkIn.channel, request.client, pair.second) {
            // The service has its end; the client's answer follows below.
            Ok -> {}
            Error(failed) -> {
                log warn(
                    "cannot hand a service its client",
                    service: services[service].name,
                    error: errorName(failed)
                )
                release(pair.first)
                checkOut(service)
                return .Gone
            }
        }
        answerConnected(request, pair.first)
        return .Handed
    }

    // `connectService` for the service `name`.
    function connect(borrow mut self, request: ConnectRequest, name: borrow String) {
        let service = match serviceIndex(name) {
            Some(index) -> index
            None -> {
                refuseConnect(request, .NotFound)
                return
            }
        }
        if !holds(request.client.program, services[service].entitlement) {
            log warn(
                "a program lacks the entitlement for a service",
                program: programName(request.client.program),
                service: name
            )
            refuseConnect(request, .NotEntitled)
            return
        }
        if isCheckedIn(service) {
            match deliver(service, request) {
                Handed -> return
                // The service went between the check and the delivery; the
                // client waits below for it to come back.
                Gone -> {}
            }
        }
        let moment = match now() {
            Ok(value) -> value
            Error(failed) -> {
                log warn("cannot time a client waiting for a service", error: errorName(failed))
                refuseConnect(request, .Internal)
                return
            }
        }
        waiting.append(
            WaitingClient {
                request: move request,
                service: service,
                deadline: moment + Waiting.patience
            }
        )
    }

    // Drops what a System channel that closed was waiting for.
    function forgetWaiting(borrow mut self, system: Handle) {
        var still: [WaitingClient] = []
        for waiter in waiting {
            if waiter.request.client.channel != system { still.append(waiter) }
        }
        waiting = still
    }

    // Answers and closes a newcomer the broker will not keep.
    function refuseCheckIn(
        borrow self,
        newcomer: borrow Peer,
        operationCode: UN32,
        code: borrow ErrorCode
    ) {
        match sendCheckInReply(newcomer.channel, operationCode, code) {
            // The refusal is sent; the newcomer is closed below either way.
            Ok -> {}
            Error(failed) -> log warn("cannot refuse a check-in", error: errorName(failed))
        }
        release(newcomer.channel)
    }

    // Whether the newcomer stays open as the service's.
    function checkIn(
        borrow mut self,
        newcomer: borrow Peer,
        name: borrow String
    ) -> NewcomerOutcome {
        let operationCode = code(CheckInOp.CheckIn)
        let service = match serviceIndex(name) {
            Some(index) -> index
            None -> {
                refuseCheckIn(newcomer, operationCode, .NotFound)
                return .Refused
            }
        }
        if newcomer.program != .Some(services[service].program) {
            log warn(
                "a program may not check in as this service",
                program: programName(newcomer.program),
                service: name
            )
            refuseCheckIn(newcomer, operationCode, .NotEntitled)
            return .Refused
        }
        if isCheckedIn(service) {
            refuseCheckIn(newcomer, operationCode, .AlreadyExists)
            return .Refused
        }
        match sendCheckInReply(newcomer.channel, operationCode, .Ok) {
            // The check-in is answered; the connection stays open as the service's.
            Ok -> {}
            Error(failed) -> {
                log warn("cannot answer a check-in", service: name, error: errorName(failed))
                release(newcomer.channel)
                return .Refused
            }
        }
        services[service].checkIn = .Some(CheckIn { channel: newcomer.channel, key: newcomer.key })
        log info("a service checked in", service: name, process: newcomer.process)
        deliverWaiting(service)
        return .Kept
    }

    // Everyone who asked for `service` while it was away.
    function deliverWaiting(borrow mut self, service: Number) {
        let asked = waiting
        waiting = []
        for waiter in asked {
            if waiter.service != service {
                waiting.append(waiter)
                continue
            }
            match deliver(service, waiter.request) {
                Handed -> {}
                Gone -> waiting.append(waiter)
            }
        }
    }

    // Reads a newcomer's first message. A check-in the broker allows makes it
    // a service's; a Channel message makes it a System channel, which joins
    // `systems` and stays open.
    function greet(borrow mut self, index: Number) {
        let blockBytes = zeroedBlock(count: CheckInWire.messageBytes, alignment: 16)
        let block = blockBytes.pointer()
        let newcomer = newcomers[index]
        let received = match receiveBrokerMessage(newcomer.channel, block) {
            Ok(value) -> value
            Error(failed) -> {
                if failed.code == .ShouldWait {
                    arm(newcomer.channel, newcomer.key)
                } else {
                    release(newcomer.channel)
                    dropNewcomer(index)
                }
                return
            }
        }
        dropNewcomer(index)
        match received.kind {
            ChannelMessage -> becomeSystem(move newcomer, block, received.bytes)
            CheckInWire -> {
                let outcome = match checkInRequest(block) {
                    CheckIn(name) -> checkIn(newcomer, name)
                    Post -> refused(newcomer, code(CheckInOp.Post), .Unsupported)
                    Malformed(operationCode) -> refused(newcomer, operationCode, .InvalidArgument)
                    Unsupported(operationCode) -> refused(newcomer, operationCode, .Unsupported)
                }
                match outcome {
                    Kept -> arm(newcomer.channel, newcomer.key)
                    // A refused newcomer is answered and closed by the refusal.
                    Refused -> {}
                }
            }
        }
    }

    // Refuses a newcomer; it does not stay.
    function refused(
        borrow self,
        newcomer: borrow Peer,
        operationCode: UN32,
        code: borrow ErrorCode
    ) -> NewcomerOutcome {
        refuseCheckIn(newcomer, operationCode, code)
        return .Refused
    }

    function dropNewcomer(borrow mut self, index: Number) {
        var staying: [Peer] = []
        for (position, newcomer) in newcomers.enumerated() {
            if position != index { staying.append(newcomer) }
        }
        newcomers = staying
    }

    // When a client waiting for a service is due to give up, if one is.
    function nextDeadline(borrow self) -> Number {
        var next: Number = Deadline.infinite
        for waiter in waiting {
            next = min(next, waiter.deadline)
        }
        return next
    }

    // Answers `Timeout` to every client whose service did not come in time.
    function expire(borrow mut self) -> Result<Void, TesseraError> {
        let moment = try now()
        let asked = waiting
        waiting = []
        for waiter in asked {
            if waiter.deadline <= moment {
                log info(
                    "a program gave up waiting for a service",
                    program: programName(waiter.request.client.program),
                    service: services[waiter.service].name
                )
                refuseConnect(waiter.request, .Timeout)
            } else {
                waiting.append(waiter)
            }
        }
        return .Ok
    }
}
