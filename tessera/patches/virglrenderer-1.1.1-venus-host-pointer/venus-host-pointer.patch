+/* Allocates shared memory and hands the driver a pointer into it.
+ *
+ * The inverse of every other path in this file. Those ask the driver for memory
+ * and then for a handle to share it by; this one allocates the memory itself and
+ * asks the driver to adopt it. A driver that can do this needs no exportable
+ * memory at all, which is the whole reason it exists: Metal has no dma_buf and
+ * no opaque fd to give, but it will build a buffer over pages that already
+ * exist, and MoltenVK spells that VK_EXT_external_memory_host.
+ *
+ * The descriptor is kept rather than closed, because it is what the guest's
+ * host-visible window is mapped from later. What the GPU writes through the
+ * imported pointer and what the guest reads through its window are then the same
+ * pages, with nothing copied between them.
+ */
+static VkResult
+vkr_host_pointer_get_import_info_from_allocation_info(
+   struct vkr_physical_device *physical_dev,
+   const VkMemoryAllocateInfo *alloc_info,
+   int *out_shm_fd,
+   void **out_host_ptr,
+   size_t *out_host_ptr_size,
+   VkImportMemoryHostPointerInfoEXT *out_import_info)
+{
+   const uint64_t alignment = physical_dev->min_imported_host_pointer_alignment;
+   const size_t size = (size_t)align64(alloc_info->allocationSize, alignment);
+
+   int fd = os_create_anonymous_file(size, "vkr-hostptr");
+   if (fd < 0) {
+      vkr_log("host pointer import: could not create shared memory (%s)",
+              strerror(errno));
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   void *ptr = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      vkr_log("host pointer import: could not map shared memory (%s)", strerror(errno));
+      close(fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   /* mmap answers with page-aligned memory, and every driver that offers this
+    * extension asks for page alignment or less. Checked rather than assumed,
+    * because the failure it prevents is the driver rejecting the import with a
+    * result that says nothing about alignment.
+    */
+   if (alignment && ((uintptr_t)ptr & (alignment - 1))) {
+      vkr_log("host pointer import: mapping at %p is not aligned to %" PRIu64, ptr,
+              alignment);
+      munmap(ptr, size);
+      close(fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   *out_shm_fd = fd;
+   *out_host_ptr = ptr;
+   *out_host_ptr_size = size;
+   *out_import_info = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .pNext = alloc_info->pNext,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = ptr,
+   };
+
+   return VK_SUCCESS;
+}
