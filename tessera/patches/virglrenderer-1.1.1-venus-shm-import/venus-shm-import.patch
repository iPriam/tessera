  * imported pointer and what the guest reads through its window are then the same
  * pages, with nothing copied between them.
  */
+/* Imports a shm resource, which is how a host-pointer VkDeviceMemory leaves the
+ * context that allocated it: another context attaching the blob gets it as shm.
+ * The pages are mapped again from the resource's descriptor, so the driver's
+ * buffer over them stays valid however long the memory outlives the resource,
+ * and the descriptor is kept so the memory can be exported in turn.
+ */
 static VkResult
+vkr_host_pointer_get_import_info_from_resource(
+   struct vkr_physical_device *physical_dev,
+   const struct vkr_resource *res,
+   const void *next,
+   int *out_shm_fd,
+   void **out_host_ptr,
+   size_t *out_host_ptr_size,
+   VkImportMemoryHostPointerInfoEXT *out_import_info)
+{
+   if (res->shm_fd < 0)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   int fd = os_dupfd_cloexec(res->shm_fd);
+   if (fd < 0)
+      return VK_ERROR_TOO_MANY_OBJECTS;
+
+   void *ptr = mmap(NULL, res->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      vkr_log("host pointer import: could not map resource %u (%s)", res->res_id,
+              strerror(errno));
+      close(fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   const uint64_t alignment = physical_dev->min_imported_host_pointer_alignment;
+   if (alignment && ((uintptr_t)ptr & (alignment - 1))) {
+      vkr_log("host pointer import: mapping at %p is not aligned to %" PRIu64, ptr,
+              alignment);
+      munmap(ptr, res->size);
+      close(fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   *out_shm_fd = fd;
+   *out_host_ptr = ptr;
+   *out_host_ptr_size = res->size;
+   *out_import_info = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .pNext = next,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = ptr,
+   };
+   return VK_SUCCESS;
+}
+
