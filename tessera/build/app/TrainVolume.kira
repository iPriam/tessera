import Foundation
import Build

// Install a train once, then give each workspace a qcow2 disk backed by the
// immutable raw volume. Guest writes occupy only that workspace's delta.
function trainVolume(
    host: borrow Host,
    architecture: Architecture,
    images: borrow BootImages,
    options: borrow BootOptions
) -> Result<String, String> {
    let reference = ArtifactReference { name: "system.img", digest: copy images.systemDigest, kind: .File }
    let shared = match buildArtifactAuxiliaryDirectory(reference, "volume-" + architecture.name()) {
        Ok(path) -> path
        Error(failure) -> return .Error("cannot locate shared train volume: \(traceText(failure))")
    }
    let lock = match openFileHandle(shared + "/lock", .ReadWrite) {
        Ok(opened) -> opened
        Error(failure) -> return .Error("cannot open train volume lock: \(traceText(failure))")
    }
    match lock.lock(true) {
        Ok(held) -> {
            if !held { return .Error("cannot lock train volume") }
        }
        Error(failure) -> return .Error("cannot lock train volume: \(traceText(failure))")
    }
    let result = makeTrainVolume(host, architecture, images, options, shared)
    match lock.close() {
        Ok -> {}
        Error(failure) -> return .Error("cannot close train volume lock: \(traceText(failure))")
    }
    let base = try result
    return workspaceTrainDisk(host, architecture, images.systemDigest, base)
}

function makeTrainVolume(
    host: borrow Host,
    architecture: Architecture,
    images: borrow BootImages,
    options: borrow BootOptions,
    shared: borrow String
) -> Result<String, String> {
    let base = shared + "/base.img"
    if fileExists(base) { return .Ok(base) }
    let part = base + ".part"
    try installSystem(host, architecture, images, images.system, images.systemDigest,
        part, shared + "/installed", options)
    match setFileMode(part, 292) {
        Ok -> {}
        Error(failure) -> return .Error("cannot protect train volume: \(traceText(failure))")
    }
    match renamePath(part, base) {
        Ok -> return .Ok(base)
        Error(failure) -> return .Error("cannot publish train volume: \(traceText(failure))")
    }
}

function workspaceTrainDisk(
    host: borrow Host,
    architecture: Architecture,
    digest: borrow String,
    base: borrow String
) -> Result<String, String> {
    let machine = host.machineDirectory(architecture)
    let disk = machine + "/train.qcow2"
    let record = machine + "/volume.train"
    if fileExists(disk) {
        let recorded = match readFile(record) {
            Ok(contents) -> contents.text.trim()
            Error(failure) -> return .Error("workspace disk has no train record: \(traceText(failure))")
        }
        if recorded != digest { return .Error("workspace disk belongs to another train; create a new workspace") }
        return .Ok(disk)
    }
    let part = disk + ".part"
    if fileExists(part) {
        match removePath(part) {
            Ok -> {}
            Error(failure) -> return .Error("cannot remove incomplete workspace disk: \(traceText(failure))")
        }
    }
    try hostCommand(host.find("qemu-img"), ["create", "-f", "qcow2", "-F", "raw", "-b", copy base, part])
    match renamePath(part, disk) {
        Ok -> {}
        Error(failure) -> return .Error("cannot publish workspace disk: \(traceText(failure))")
    }
    match writeFile(record, digest + "\n") {
        Ok -> return .Ok(disk)
        Error(failure) -> return .Error("cannot record workspace disk train: \(traceText(failure))")
    }
}
