import Foundation
import Build

// Exercise the actual disk helper with small sparse disks, without booting
// or touching any development VM. QEMU verifies writes stay in one delta.
construct WorkspaceTrainDisksShareBacking() extends Test {
    test {
        let temporary = environmentValue("TMPDIR")
        let root = (temporary.count > 0 ? temporary : "/tmp") + "/tessera-train-disk-" + String(unixMillis())
        let result = trainDiskProbe(root)
        match removePath(root) {
            Ok -> {}
            Error(failure) -> return "cannot remove disk probe: \(traceText(failure))"
        }
        return match result {
            Ok -> "shared base, isolated writes, stable reopen, base mismatch rejected"
            Error(problem) -> problem
        }
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("shared base, isolated writes, stable reopen, base mismatch rejected")
        return e
    }
}

function trainDiskProbe(root: borrow String) -> Result<Void, String> {
    let first = Host {
        architecture: .Aarch64, darwin: true, home: environmentValue("HOME"),
        path: environmentValue("PATH"), buildRoot: root + "/one", llvm: ""
    }
    let second = Host {
        architecture: .Aarch64, darwin: true, home: environmentValue("HOME"),
        path: environmentValue("PATH"), buildRoot: root + "/two", llvm: ""
    }
    for directory in [first.machineDirectory(.Aarch64), second.machineDirectory(.Aarch64)] {
        match makePathTree(directory) {
            Ok -> {}
            Error(failure) -> return .Error("cannot prepare disk probe: \(traceText(failure))")
        }
    }
    let base = root + "/base.img"
    match setFileLength(base, 64 * 1048576) {
        Ok -> {}
        Error(failure) -> return .Error("cannot create disk probe base: \(traceText(failure))")
    }
    let digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let one = try workspaceTrainDisk(first, .Aarch64, digest, base)
    let two = try workspaceTrainDisk(second, .Aarch64, digest, base)
    let reopened = try workspaceTrainDisk(first, .Aarch64, digest, base)
    if one == two || reopened != one { return .Error("workspace disks are not isolated and stable") }
    try hostCommand(first.find("qemu-img"), ["check", one])
    try hostCommand(first.find("qemu-io"), ["-f", "qcow2", "-c", "write -P 0x5a 0 4096", one])
    try hostCommand(first.find("qemu-io"), ["-f", "qcow2", "-c", "read -P 0x5a 0 4096", one])
    try hostCommand(first.find("qemu-io"), ["-f", "qcow2", "-c", "read -P 0 0 4096", two])
    try hostCommand(first.find("qemu-io"), ["-f", "raw", "-c", "read -P 0 0 4096", base])
    return match workspaceTrainDisk(first, .Aarch64,
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", base) {
        Ok(path) -> .Error("workspace disk accepted another train")
        Error(problem) -> .Ok
    }
}
