# What aarch64 needs on top of kernel/config/tessera-common.config.
#
# aarch64 is Tessera's primary architecture. It is built for QEMU's `virt`
# machine, which is a synthetic platform: no firmware tables to discover
# devices with beyond what QEMU's device tree describes, and PL011 rather than
# an 8250 for the console.

CONFIG_ARM64=y

# The PL011, which is the `virt` machine's console.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_AMBA=y

# The `virt` machine's generic PCI host bridge, and the MMIO virtio transport
# it exposes devices over when they are not on PCI.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# Power off from inside the guest through PSCI, which is how the `virt`
# machine's firmware interface asks the hypervisor to stop.
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_ACPI_PARKING_PROTOCOL=y

# 16K pages and a 48-bit address space.
#
# 4K is what the widest set of aarch64 hardware agrees on, and it is the wrong
# choice here. Apple silicon has a 16K page, and a hypervisor can only map guest
# memory at its own page granularity: Hypervisor.framework's hv_vm_map takes
# 16K-aligned addresses and sizes. A 4K guest asking for a host-visible GPU
# buffer at a 4K-aligned offset therefore asks for something the host cannot map,
# and the guest's first access to it faults with no instruction syndrome for the
# hypervisor to decode — QEMU stops on an assertion inside its own vcpu loop,
# naming nothing that would lead back here.
#
# 16K costs nothing elsewhere. It is what Apple's own kernels and the Linux
# distributions for this hardware use, and every hypervisor and emulator Tessera
# runs under handles it.
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y

# No aarch32 userland, so no compat layer and no compat vDSO.
#
# Tessera's userland is aarch64 and nothing else: no armv7 binary is ever
# executed, so the 32-bit syscall layer is surface the system never uses. It is
# also the one part of an arm64 build that needs a second code generator — the
# compat vDSO is ARM code — and the LLVM bundle Kira pins is built for the host
# architecture alone, so on a Darwin host there is no ARM backend to build it
# with. Dropping it is the smaller kernel and the buildable one at once.
# CONFIG_COMPAT is not set

# No MTD, and so no CFI flash probe.
#
# The `virt` machine always presents two pflash banks, and defconfig binds the
# CFI driver to them — on a system that has no flash storage and boots from
# -kernel. Nothing is lost by not probing them, and something is gained: the
# probe is a write cycle into the flash command register, which makes QEMU flip
# that region from a memory mapping to MMIO mid-run. Under Hypervisor.framework
# that transition calls hv_vm_unmap on a range the hypervisor never mapped, and
# macOS kills the emulator with EXC_GUARD before the userland is ever reached.
# CONFIG_MTD is not set

# No drivers for boards Tessera does not run on.
#
# defconfig carries every vendor's SoC drivers, and a few of those announce
# themselves at boot on any machine: the Xilinx ZynqMP AES engine says AES is
# not supported on this platform, and the Raspberry Pi's audio says it cannot
# register on a VCHIQ bus that was never set up. A boot that complains about
# hardware it does not have hides the complaints that matter.
# CONFIG_CRYPTO_DEV_ZYNQMP_AES is not set
# CONFIG_SND_BCM2835 is not set
