# What x86_64 needs on top of kernel/config/tessera-common.config.
#
# x86_64 is the compatibility target, carried while aarch64 becomes the primary
# architecture. It is the host's own architecture, so it builds without a cross
# toolchain and boots fastest, which makes it the arch to debug on.

CONFIG_64BIT=y

# The PC serial port. Under QEMU's -nographic this is what stdio is wired to.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# QEMU's q35 machine presents a PCI Express root complex.
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Reboot and power off cleanly from inside the guest, so a boot test can end
# by itself rather than by a timeout.
CONFIG_ACPI=y

# The bzImage is compressed with LZ4: it is unpacked twice for every
# install-and-boot, in about 40 ms where zstd took 135 ms and gzip 210 ms. The
# image is 20 MB rather than zstd's 13 MB, which the firmware loads in a few
# milliseconds more.
CONFIG_KERNEL_LZ4=y
