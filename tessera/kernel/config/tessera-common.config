# Kernel options every Tessera target needs, merged over the architecture's
# defconfig by scripts/build-kernel.sh.
#
# This fragment says what Tessera requires of the kernel, not what a general
# purpose distribution would want. It starts from defconfig rather than
# tinyconfig deliberately: the first goal is a kernel that boots, and trimming
# is a later pass with a booting baseline to compare against.

# Boot from an initramfs, and no built-in one — the image is handed to the
# kernel by the bootloader, or by QEMU's -initrd.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# The kernel populates /dev itself and mounts it before PID 1 runs, so the
# userland never carries a static device table.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The filesystems PID 1 mounts on the way up.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# A serial console is the only output path during bring-up, and stays the
# channel the boot is judged by afterwards.
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# ELF binaries, which is what the Kira toolchain emits.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Virtio is the whole hardware story under QEMU, and the transport the
# development loop runs on.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# The system volume is squashfs. aarch64's defconfig turns it on and x86_64's
# does not, so the root a system boot mounts is asked for here.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y

# An installed application is a squashfs image kept as a file in
# /Applications, and PID 1 mounts it through a loop device when it is opened
# (roadmap/12-apps.md). No devices are made ahead: PID 1 asks loop-control
# for a free one, so DeviceKit never lists idle ones.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0

# A display device. virtio-gpu is the same virtio hardware story as the rest:
# a synthetic GPU QEMU presents over PCI, driven by the kernel's own DRM stack.
# This is the load-bearing base a userland graphics stack sits on — it brings up
# the device and creates /dev/dri/card0 — not a graphics stack in itself.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# Emulate a framebuffer over DRM and put the kernel console on it, so the boot is
# visible on the graphical display and not only on the serial line. The serial
# console stays primary — it is what the boot test still asserts on.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Enough of a network stack to reach the host from inside the guest.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y

# The sealed system volumes are squashfs; the writable data volume is btrfs.
#
# btrfs is chosen for the data volume because its copy-on-write subvolumes are
# how an agent gets cheap, isolated state: a subvolume snapshot shares every
# unchanged block with its parent and diverges only where it is written, so
# forking an agent's world and rolling it back are metadata operations rather
# than copies. ext4 stays available for anything that wants a plain volume.
#
# btrfs selects its own crc32c and compression dependencies in Kconfig; the
# lines below are set explicitly so a defconfig that left them off does not
# silently drop a feature the data volume relies on.
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_LIBCRC32C=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
# btrfs pulls in the RAID6 library, which times every algorithm at boot to
# pick one. The data volume has no RAID profile, so the first is as good, and
# the timing is about 70 ms of every boot.
# CONFIG_RAID6_PQ_BENCHMARK is not set

# The system is sealed as roadmap/05 and 13 say: every file of the system
# snapshot has fs-verity on, and PID 1 mounts the snapshot through its
# composefs image, an EROFS image of the tree on a loop device, with overlayfs
# taking the snapshot as a data-only layer under `verity=require`.
CONFIG_FS_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_OVERLAY_FS=y

# Kept off: module loading. Everything Tessera needs is built in, so there is
# no module search path to get wrong and no module ABI to keep.
# Keyboards and pointers, over virtio.
#
# The `virt` machine has no PS/2 controller and no USB unless one is added, so
# a guest that wants to be typed at gets its devices the same way it gets its
# disk and its GPU. evdev is how they reach a program: one character device per
# device, each answering fixed-size records that say what moved and how far.
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y

# No boot logo.
#
# The kernel paints Linux's mascot into the framebuffer the moment a display
# binds, and Tessera is not Linux above the kernel: a machine that shows someone
# else's logo on the way up is telling the person watching that it is theirs.
# What is left is a black screen, which is what an unpainted framebuffer is —
# and painting it is the userland's to do.
# CONFIG_LOGO is not set

# No debug information in the kernel.
#
# Tessera ships no kernel debugger and no symbols to a debugger elsewhere: what
# a boot reports, it reports on the console. DWARF for a kernel nobody is going
# to attach gdb to costs about ten times the size of the kernel itself — an
# unstripped vmlinux near a gigabyte, an intermediate object near two, and a
# link that needs all of it resident at once. Turning it off is the difference
# between a build that fits on a laptop and one that does not.
CONFIG_DEBUG_INFO_NONE=y

# CONFIG_MODULES is not set

# What LibTessera (roadmap/16-libtessera.md) reaches.
#
# A Job is a cgroup v2 directory: its limits are the cpu, memory and pids
# controllers, and `cgroup.kill` ends it. PID 1 mounts the hierarchy.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# Cpu and Network wake locks are wakeup sources in /sys/power/wake_lock.
CONFIG_PM_SLEEP=y
CONFIG_PM_WAKELOCKS=y
# Trace events go to trace_marker.
CONFIG_FTRACE=y
CONFIG_TRACING=y

# No wireless. The defconfig's cfg80211 loads regulatory.db at boot, and the
# image carries no firmware; nothing in Tessera drives a wireless device yet.
# CONFIG_CFG80211 is not set

# What DeviceKit (roadmap/17-devicekit.md) drives, on every architecture.
#
# The Devices service plays and records through ALSA; the loopback card gives
# a machine with no sound hardware a PCM to stream to, so the path from an
# application through the service to the kernel is exercised on every boot.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_ALOOP=y
# USB audio class devices, which come and go while the machine runs: the
# Devices service posts each one to applications as `deviceChanged`.
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# The Volume service's mapper targets are device-mapper tables.
CONFIG_BLK_DEV_DM=y
# The Power service arms wake alarms on the real-time clock.
CONFIG_RTC_CLASS=y
# Hid and Usb, for user-space drivers: raw HID reports, and a USB host
# controller with QEMU's devices on it.
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
# CD and DVD drives on a SCSI bus, such as QEMU's virtio-scsi, whose trays
# the Volume service opens on eject (DeviceKit's `Block.eject`).
CONFIG_SCSI=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y
