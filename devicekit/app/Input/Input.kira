import Foundation
import Heap
import LibTessera

// Input (17 §13): evdev records as `InputEvent` records whose codes are USB
// HID usages, so a key means the same thing on every backend.
//
// `struct input_event` on a 64-bit machine is 24 bytes: the time at @0 (a
// `timeval`, monotonic once `EVIOCSCLOCKID` asks for it), `type` @16,
// `code` @18 and `value` @20.

// The kernel's event types. Others exist, and are skipped.
@Open enum EventType: U16 {
    Synchronize = 0
    Key = 1
    Relative = 2
    Absolute = 3
    Miscellaneous = 4
    Switch = 5
    Led = 17
    ForceFeedback = 21
}

// `SYN_*` codes.
@Open enum SyncCode: U16 {
    Report = 0
    Dropped = 3
}

namespace InputLayout {
    let kernelEvent: Number = 24
    let event: Number = 32
    let axis: Number = 24
    let usage: Number = 4
    // `ABS_MT_SLOT`, which picks the contact the next records are for, and
    // `ABS_MT_TRACKING_ID`.
    let multitouchSlot: U32 = U32(0x2f)
    let trackingId: U32 = U32(0x39)
    // `KEY_MAX + 1` bits of key state.
    let keyCodes: Number = 768
    // A key's value when the kernel repeats it.
    let repeated: U32 = U32(2)
}

// What an Input connection keeps besides its object: the touch slot the
// next absolute records belong to.
struct InputConnection {
    var object: Number
    var slot: Number?
}

function inputOf(object: Number) -> Result<Number, TesseraError> {
    for (index, input) in deviceLibrary.inputs.enumerated() {
        if input.object == object { return .Ok(index) }
    }
    return .Error(failure(.InvalidHandle))
}

namespace ClockId {
    let monotonic: U32 = U32(1)
}

// An input connection's clock is CLOCK_MONOTONIC, so timestamps are
// `Clock.Monotonic`.
function inputPrepare(object: Number) -> Result<Void, TesseraError> {
    let device = try deviceOf(object)
    let set = try device.controlWord(Evdev.setClock, ClockId.monotonic)
    deviceLibrary.inputs.append(InputConnection { object: object, slot: .None })
    return .Ok
}

function inputRelease(object: Number) {
    var kept: [InputConnection] = []
    for input in deviceLibrary.inputs {
        if input.object != object { kept.append(input) }
    }
    deviceLibrary.inputs = kept
}

// HID usage pages (§13.2: page << 16 | usage id).
namespace UsagePage {
    let genericDesktop: U32 = U32(0x01)
    let keyboard: U32 = U32(0x07)
    let button: U32 = U32(0x09)
    let consumer: U32 = U32(0x0C)
    let digitizer: U32 = U32(0x0D)
    // A kernel code no HID usage names keeps its number on the vendor page.
    let unmapped: U32 = U32(0xFF00)
}

function hidUsage(page: U32, usage: U32) -> U32 { return (page << U32(16)) | usage }

// Linux key codes by HID keyboard usage (page 7): the kernel's
// `hid_keyboard` table, 0 where a usage has no key.
let keyboardCodes: [U32] = [U32(0), U32(0), U32(0), U32(0), U32(30), U32(48), U32(46), U32(32), U32(
    18
), U32(33), U32(34), U32(35), U32(23), U32(36), U32(37), U32(38), U32(50), U32(49), U32(24), U32(
    25
), U32(16), U32(19), U32(31), U32(20), U32(22), U32(47), U32(17), U32(45), U32(21), U32(44), U32(
    2
), U32(3), U32(4), U32(5), U32(6), U32(7), U32(8), U32(9), U32(10), U32(11), U32(28), U32(1), U32(
    14
), U32(15), U32(57), U32(12), U32(13), U32(26), U32(27), U32(43), U32(0), U32(39), U32(40), U32(
    41
), U32(51), U32(52), U32(53), U32(58), U32(59), U32(60), U32(61), U32(62), U32(63), U32(64), U32(
    65
), U32(66), U32(67), U32(68), U32(87), U32(88), U32(99), U32(70), U32(119), U32(110), U32(102), U32(
    104
), U32(111), U32(107), U32(109), U32(106), U32(105), U32(108), U32(103), U32(69), U32(98), U32(
    55
), U32(74), U32(78), U32(96), U32(79), U32(80), U32(81), U32(75), U32(76), U32(77), U32(71), U32(
    72
), U32(73), U32(82), U32(83), U32(86), U32(127), U32(0), U32(117), U32(183), U32(184), U32(
    185
), U32(186), U32(187), U32(188), U32(189), U32(190), U32(191), U32(192), U32(193), U32(194), U32(
    134
), U32(138), U32(130), U32(132), U32(128), U32(129), U32(131), U32(137), U32(133), U32(135), U32(
    136
), U32(0),]

// The modifier keys' codes, usages 0xE0 to 0xE7.
let modifierCodes: [U32] = [U32(29), U32(42), U32(56), U32(125), U32(97), U32(54), U32(100), U32(
    126
)]

namespace KeyboardUsage {
    let firstModifier: U32 = U32(0xE0)
}

// The keyboard usage of a Linux key code: the first usage the table gives
// it.
function keyboardUsage(eventCode: U32) -> U32? {
    if eventCode == 0 { return .None }
    for (usage, key) in keyboardCodes.enumerated() {
        if key == eventCode { return .Some(U32(usage)) }
    }
    for (index, key) in modifierCodes.enumerated() {
        if key == eventCode { return .Some(KeyboardUsage.firstModifier + U32(index)) }
    }
    return .None
}

function keyUsage(eventCode: U32) -> U32 {
    // Mouse and stylus buttons, then the touch contact and the stylus.
    if eventCode >= 0x110 && eventCode <= 0x117 {
        return hidUsage(UsagePage.button, eventCode - 0x110 + 1)
    }
    if eventCode == 0x14a { return hidUsage(UsagePage.digitizer, U32(0x42)) }
    if eventCode == 0x140 { return hidUsage(UsagePage.digitizer, U32(0x20)) }
    if eventCode == 0x145 { return hidUsage(UsagePage.digitizer, U32(0x22)) }
    if eventCode == 0x14b || eventCode == 0x14c {
        return hidUsage(UsagePage.digitizer, U32(0x44) + (eventCode - 0x14b))
    }
    // Power, then the volume buttons.
    if eventCode == 116 { return hidUsage(UsagePage.genericDesktop, U32(0x81)) }
    if eventCode == 115 { return hidUsage(UsagePage.consumer, U32(0xE9)) }
    if eventCode == 114 { return hidUsage(UsagePage.consumer, U32(0xEA)) }
    if eventCode == 113 { return hidUsage(UsagePage.consumer, U32(0xE2)) }
    return match keyboardUsage(eventCode) {
        Some(usage) -> hidUsage(UsagePage.keyboard, usage)
        None -> hidUsage(UsagePage.unmapped, eventCode)
    }
}

function relativeUsage(eventCode: U32) -> U32 {
    return match eventCode {
        0 -> hidUsage(UsagePage.genericDesktop, U32(0x30))
        1 -> hidUsage(UsagePage.genericDesktop, U32(0x31))
        2 -> hidUsage(UsagePage.genericDesktop, U32(0x32))
        8 -> hidUsage(UsagePage.genericDesktop, U32(0x38))
        6 -> hidUsage(UsagePage.consumer, U32(0x238))
        else -> hidUsage(UsagePage.unmapped, eventCode)
    }
}

function absoluteUsage(eventCode: U32) -> U32 {
    return match eventCode {
        0, 0x35 -> hidUsage(UsagePage.genericDesktop, U32(0x30))
        1, 0x36 -> hidUsage(UsagePage.genericDesktop, U32(0x31))
        2 -> hidUsage(UsagePage.genericDesktop, U32(0x32))
        0x18, 0x3a -> hidUsage(UsagePage.digitizer, U32(0x30))
        0x39 -> hidUsage(UsagePage.digitizer, U32(0x51))
        0x30 -> hidUsage(UsagePage.digitizer, U32(0x48))
        0x31 -> hidUsage(UsagePage.digitizer, U32(0x49))
        else -> hidUsage(UsagePage.unmapped, eventCode)
    }
}

// `InputEvent.flags`.
namespace InputEventFlags {
    let none: U16 = U16(0)
    let repeat: U16 = U16(1)
}

// One `InputEvent` (32 bytes) before its time is known.
struct InputRecord {
    var kind: InputEventKind
    var flags: U16
    var usage: U32
    var value: U32
    var slot: Number?
    var tracking: Number?

    function write(borrow self, out: RawPtr, at: Number, time: Number) {
        heapStore<U64>(out, at, U64(time))
        heapStore<U16>(out, at + 8, code(self.kind))
        heapStore<U16>(out, at + 10, self.flags)
        heapStore<U32>(out, at + 12, self.usage)
        heapStore<U32>(out, at + 16, self.value)
        heapStore<U32>(out, at + 20, word32Of(self.slot.or(-1)))
        heapStore<U32>(out, at + 24, word32Of(self.tracking.or(-1)))
        heapStore<U32>(out, at + 28, U32(0))
    }
}

function plainRecord(kind: borrow InputEventKind, usage: U32, value: U32) -> InputRecord {
    return InputRecord {
        kind: kind,
        flags: InputEventFlags.none,
        usage: usage,
        value: value,
        slot: .None,
        tracking: .None
    }
}

// The record a kernel event becomes; none for the ones that only steer the
// records after them, or that §13 does not report.
function translate(
    input: Number,
    kind: borrow EventType,
    eventCode: U32,
    value: U32
) -> InputRecord? {
    return match kind {
        Synchronize -> match fromCode<SyncCode>(U16(eventCode)) {
            Report -> .Some(plainRecord(.Frame, U32(0), U32(0)))
            Dropped -> .Some(plainRecord(.Dropped, U32(0), U32(0)))
            else -> .None
        }
        Key -> {
            let repeated = value == InputLayout.repeated
            var record = plainRecord(.Key, keyUsage(eventCode), repeated ? U32(1) : value)
            if repeated { record.flags = InputEventFlags.repeat }
            .Some(record)
        }
        Relative -> .Some(plainRecord(.Relative, relativeUsage(eventCode), value))
        Absolute -> {
            if eventCode == InputLayout.multitouchSlot {
                deviceLibrary.inputs[input].slot = .Some(signedOf32(value))
                return .None
            }
            var record = plainRecord(.Absolute, absoluteUsage(eventCode), value)
            if eventCode > InputLayout.multitouchSlot { record.slot = deviceLibrary.inputs[input].slot }
            if eventCode == InputLayout.trackingId && value != U32(0xFFFFFFFF) {
                record.tracking = .Some(signedOf32(value))
            }
            .Some(record)
        }
        Switch -> .Some(plainRecord(.Switch, hidUsage(UsagePage.unmapped, eventCode), value))
        else -> .None
    }
}

public function inputRead(input: Ref, out: borrow Buffer) -> Result<Number, TesseraError> {
    let object = try resolveConnection(input, .Input, RefRights.read)
    let index = try inputOf(object)
    let room = trunc(out.length / InputLayout.event)
    if room == 0 || isNull(out.address) {
        return .Error(failure(.BufferTooSmall, Number(InputLayout.event)))
    }
    let device = try deviceOf(object)
    let blockBytes = zeroedBlock(count: room * InputLayout.kernelEvent, alignment: 16)
    let block = blockBytes.pointer()
    let got = match device.read(block, Number(room * InputLayout.kernelEvent)) {
        Ok(value) -> value
        Error(failed) -> {
            match errnoOf(failed) {
                Again -> return .Error(failure(.ShouldWait))
                NoDevice -> {
                    deviceLibrary.objects[object].state = .Lost
                    return .Error(failed)
                }
                else -> return .Error(failed)
            }
        }
    }
    var written = 0
    for item in 0..trunc(got / InputLayout.kernelEvent) {
        let at = item * InputLayout.kernelEvent
        let kind = fromCode<EventType>(heapLoad<U16>(block, at + 16))
        let eventCode = U32(heapLoad<U16>(block, at + 18))
        let value = heapLoad<U32>(block, at + 20)
        match translate(index, kind, eventCode, value) {
            Some(record) -> {
                record.write(
                    out.address,
                    written * InputLayout.event,
                    loadTime(block, at, Time.nanosecondsPerMicrosecond)
                )
                written++
            }
            None -> {}
        }
    }
    if written == 0 { return .Error(failure(.ShouldWait)) }
    return .Ok(Number(written))
}

// The absolute axes a device reports, from its `EV_ABS` bits.
function absoluteAxes(device: borrow Descriptor) -> Result<[U32], TesseraError> {
    let bitsBytes = zeroedBlock(count: 8, alignment: 16)
    let bits = bitsBytes.pointer()
    let read = try device.control(evdevGetBits(U64(code(EventType.Absolute)), U64(8)), bits)
    let mask = heapLoad<U64>(bits, 0)
    var axes: [U32] = []
    for axis in 0..64 {
        if (mask & (U64(1) << U64(axis))) != U64(0) && U32(axis) != InputLayout.multitouchSlot {
            axes.append(U32(axis))
        }
    }
    return .Ok(axes)
}

// Each `AxisInfo`, from `struct input_absinfo`: value, minimum, maximum,
// fuzz, flat, resolution.
public function inputAxes(input: Ref, out: borrow Buffer) -> Result<Number, TesseraError> {
    let object = try resolveConnection(input, .Input, RefRights.read)
    let device = try deviceOf(object)
    let axes = try absoluteAxes(device)
    try requireRoom(out, Number(8 + axes.count * InputLayout.axis))
    writeListHeader(out.address, axes.count, InputLayout.axis)
    let infoBytes = zeroedBlock(count: InputLayout.axis, alignment: 16)
    let info = infoBytes.pointer()
    for (item, axis) in axes.enumerated() {
        let at = 8 + item * InputLayout.axis
        zeroBytes(info, InputLayout.axis)
        let read = try device.control(evdevGetAbs(U64(axis)), info)
        heapStore<U32>(out.address, at, absoluteUsage(axis))
        heapStore<U32>(out.address, at + 4, heapLoad<U32>(info, 20))
        heapStore<U32>(out.address, at + 8, heapLoad<U32>(info, 4))
        heapStore<U32>(out.address, at + 12, heapLoad<U32>(info, 8))
        heapStore<U32>(out.address, at + 16, heapLoad<U32>(info, 12))
        heapStore<U32>(out.address, at + 20, heapLoad<U32>(info, 16))
    }
    return .Ok(Number(axes.count))
}

public function inputState(input: Ref, out: borrow Buffer) -> Result<Number, TesseraError> {
    let object = try resolveConnection(input, .Input, RefRights.read)
    let device = try deviceOf(object)
    let keyBytes = InputLayout.keyCodes / 8
    let keysBlock = zeroedBlock(count: keyBytes, alignment: 16)
    let keys = keysBlock.pointer()
    let read = try device.control(evdevGetKeys(U64(keyBytes)), keys)
    var held: [U32] = []
    for key in 0..InputLayout.keyCodes {
        if (heapLoad<U8>(keys, trunc(key / 8)) & (U8(1) << U8(key % 8))) != U8(0) {
            held.append(keyUsage(U32(key)))
        }
    }
    try requireRoom(out, Number(8 + held.count * InputLayout.usage))
    writeListHeader(out.address, held.count, InputLayout.usage)
    for (index, usage) in held.enumerated() {
        heapStore<U32>(out.address, 8 + index * InputLayout.usage, usage)
    }
    return .Ok(Number(held.count))
}

// One `input_event` written to the device.
function writeEvent(
    device: borrow Descriptor,
    kind: borrow EventType,
    eventCode: U16,
    value: U32
) -> Result<Void, TesseraError> {
    let blockBytes = zeroedBlock(count: InputLayout.kernelEvent, alignment: 16)
    let block = blockBytes.pointer()
    heapStore<U16>(block, 16, code(kind))
    heapStore<U16>(block, 18, eventCode)
    heapStore<U32>(block, 20, value)
    let wrote = try device.write(block, Number(InputLayout.kernelEvent))
    return .Ok
}

// The LED bits are the kernel's `LED_*` numbers in the same order.
public function inputSetLeds(input: Ref, leds: InputLeds) -> Result<Void, TesseraError> {
    let object = try resolveConnection(input, .Input, RefRights.write)
    let device = try deviceOf(object)
    let all = [InputLeds.numLock, InputLeds.capsLock, InputLeds.scrollLock, InputLeds.compose, InputLeds.kana]
    for (led, bit) in all.enumerated() {
        try writeEvent(device, .Led, U16(led), leds.has(bit) ? U32(1) : U32(0))
    }
    return writeEvent(device, .Synchronize, code(SyncCode.Report), U32(0))
}
