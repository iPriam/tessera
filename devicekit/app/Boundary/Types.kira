}

// `Camera.control` ids (§14.2). 17 calls them controls; LibTessera exports
// `CameraControl`, so here they are settings.
public enum CameraSetting: U32 {
    Exposure = 1
    Gain = 2
    Focus = 3
    WhiteBalance = 4
    Zoom = 5
    Torch = 6
    PowerLineFrequency = 7
}

// A `Camera.control` value that reads the setting without changing it.
public namespace CameraValue {
    let read: Number = -9223372036854775807
}

// `SensorChannel.format`.
public enum SensorChannelFormat: U32 {
    S16 = 1
    S32 = 2
    U64Count = 3
}

public distinct HapticCapabilities = U32

public namespace HapticCapabilities {
    let none: HapticCapabilities = HapticCapabilities(0)
    let rumble: HapticCapabilities = HapticCapabilities(1)
    let periodic: HapticCapabilities = HapticCapabilities(2)
    let customWaveform: HapticCapabilities = HapticCapabilities(4)
    let gain: HapticCapabilities = HapticCapabilities(8)
}

// ─── Power (§15) ────────────────────────────────────────────────────────────

public enum PowerSourceKind: U32 {
    Unknown = 0
    Battery = 1
    Mains = 2
    Usb = 3
    Wireless = 4
}

// `PowerSourceInfo.state`: LibTessera's `BatteryState` values, which are
// not named here because a RIDL record takes no other module's type.
public enum ChargeState: U32 {
    Unknown = 0
    Discharging = 1
    Charging = 2
    Full = 3
    NotCharging = 4
}

@Derive(Copy)
public struct PowerSourceInfo {
    var kind: PowerSourceKind
    var state: ChargeState
    var online: UN32
    var percent: UN32
    var energyNowUwh: UNumber
    var energyFullUwh: UNumber
    var powerNowUw: UNumber
    var voltageUv: UNumber
    var timeToEmpty: UNumber
    var timeToFull: UNumber
}

public enum ThermalKind: U32 {
    Unknown = 0
    Cpu = 1
    Gpu = 2
    Battery = 3
    Skin = 4
    Other = 5
}

// `ThermalInfo.policyLevel`. LibTessera exports `ThermalLevel`.
public enum ThermalPolicy: U32 {
    Nominal = 0
    Fair = 1
    Serious = 2
    Critical = 3
}

@Derive(Copy)
public struct ThermalInfo {
    var kind: ThermalKind
    var tripCount: UN32
    var milliCelsius: N32
    var policyLevel: ThermalPolicy
}

// `Suspend.enter`.
public enum SuspendState: U32 {
    Idle = 1
    Memory = 2
    Disk = 3
}

