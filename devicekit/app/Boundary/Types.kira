import Foundation
import LibTessera

// The types at DeviceKit's boundary (17 §3.1). Every record is plain so its
// RIDL shape is its byte layout; the records DeviceKit writes into a caller's
// `Buffer` keep the layouts 17 states and are built byte by byte. A distinct
// integer crosses RIDL as `{ raw }`, which is the shape §3.1 gives `Ref`,
// `RefRights` and `DeviceEvents`.

// A DeviceKit object reference (§4.1): an index and a generation in this
// process's table. 0 is invalid.
public distinct Ref = U64

// A registry entry, stable for one boot; 0 is none.
public distinct EntryId = U64

// A pixel format, the DRM fourcc values.
public distinct FourCc = U32

// A buffer layout, the DRM modifier values; 0 is linear.
public distinct Modifier = U64

// A single-use transfer token (§9.6).
@Derive(Copy)
public struct Token {
    var high: UNumber
    var low: UNumber
}

// A kernel object for a graphics API import (§9.7).
@Derive(Copy)
public struct NativeHandle {
    var kind: NativeKind
    var value: UNumber
}

// ─── Objects (§4.2) ─────────────────────────────────────────────────────────

public enum DeviceObject: U32 {
    None = 0
    Connection = 1
    Surface = 2
    Fence = 3
    Framebuffer = 4
    RegistryWatch = 5
    WakeSource = 6
    Mapper = 7
    Driver = 9
}

// `RefInfo.state`.
public enum ObjectState: U32 {
    Ok = 0
    Lost = 1
    Error = 2
    Suspended = 3
}

@Derive(Copy)
public struct RefInfo {
    var objectType: DeviceObject
    var state: ObjectState
    var rights: RefRights
    var entry: EntryId
    var objectId: UNumber
}

// ─── Rights (§4.3) ──────────────────────────────────────────────────────────

public distinct RefRights = U64

public namespace RefRights {
    let none: RefRights = RefRights(0)
    let duplicate: RefRights = RefRights(1)
    let export: RefRights = RefRights(2)
    let read: RefRights = RefRights(4)
    let write: RefRights = RefRights(8)
    let map: RefRights = RefRights(0x10)
    let wait: RefRights = RefRights(0x80)
    let inspect: RefRights = RefRights(0x100)
    let manage: RefRights = RefRights(0x200)
    let setProperty: RefRights = RefRights(0x400)
    let native: RefRights = RefRights(0x10000)
    let master: RefRights = RefRights(0x20000)
    let grab: RefRights = RefRights(0x40000)
    // `Ref.duplicate` and the exports: the same rights as the source.
    let same: RefRights = RefRights(0xFFFFFFFFFFFFFFFF)
}

// ─── Events (§4.4) ──────────────────────────────────────────────────────────

public distinct DeviceEvents = U32

public namespace DeviceEvents {
    let none: DeviceEvents = DeviceEvents(0)
    let readable: DeviceEvents = DeviceEvents(1)
    let writable: DeviceEvents = DeviceEvents(2)
    let lost: DeviceEvents = DeviceEvents(4)
    let signaled: DeviceEvents = DeviceEvents(8)
    let idle: DeviceEvents = DeviceEvents(0x10)
    let error: DeviceEvents = DeviceEvents(0x20)
    let reset: DeviceEvents = DeviceEvents(0x40)
    let changed: DeviceEvents = DeviceEvents(0x80)
    let suspending: DeviceEvents = DeviceEvents(0x100)
    let resumed: DeviceEvents = DeviceEvents(0x200)
}

// ─── Completions (§6.2), in `aux` ───────────────────────────────────────────

public enum DeviceCompletion: U32 {
    Event = 1
    Open = 2
    Import = 3
    Fence = 4
    Flip = 5
    Transfer = 6
    Suspend = 7
    Token = 8
}

// ─── Registry (§7.2) ────────────────────────────────────────────────────────

// 17 §7.2 calls this `DeviceClass`, which LibTessera already exports, and
// §3.2 forbids sharing a name with it.
public enum EntryClass: U32 {
    Unknown = 0
    Bus = 1
    GpuAdapter = 2
    DisplayController = 3
    Connector = 4
    InputDevice = 5
    AudioCard = 6
    AudioEndpoint = 7
    Camera = 8
    Sensor = 9
    HapticDevice = 10
    PowerSource = 11
    ThermalZone = 12
    Backlight = 13
    BlockDevice = 14
    Partition = 15
    HidDevice = 16
    UsbDevice = 17
    UsbInterface = 18
    Rtc = 19
    Driver = 20
}

public enum Family: U32 {
    None = 0
    Gpu = 1
    Display = 2
    Input = 3
    Audio = 4
    Camera = 5
    Sensor = 6
    Haptic = 7
    PowerSource = 8
    Thermal = 9
    Backlight = 10
    Block = 11
    Hid = 12
    Usb = 13
    Rtc = 14
}

public enum Plane: U32 {
    Service = 0
    Bus = 1
    Power = 2
}

public distinct EntryFlags = U32

public namespace EntryFlags {
    let none: EntryFlags = EntryFlags(0)
    let removable: EntryFlags = EntryFlags(1)
    let builtIn: EntryFlags = EntryFlags(2)
    let wakeupCapable: EntryFlags = EntryFlags(4)
    let defaultOfClass: EntryFlags = EntryFlags(8)
    let virtual: EntryFlags = EntryFlags(0x10)
}

@Derive(Copy)
public struct EntryInfo {
    var id: EntryId
    var entryClass: EntryClass
    var family: Family
    var parent: EntryId
    var generation: UNumber
    var flags: EntryFlags
    var childCount: UN32
    var name: UNumber
}

public enum PropertyType: U32 {
    Bool = 1
    I64 = 2
    U64 = 3
    String = 4
    Bytes = 5
    List = 6
}

// `RegistryChange.kind`.
public enum RegistryChangeKind: U32 {
    Matched = 1
    Terminated = 2
    PropertiesChanged = 3
    Resync = 4
}

// ─── Connections (§8.2) ─────────────────────────────────────────────────────

public distinct OpenOptions = U32

public namespace OpenOptions {
    let none: OpenOptions = OpenOptions(0)
    let exclusive: OpenOptions = OpenOptions(1)
    let master: OpenOptions = OpenOptions(2)
    let grab: OpenOptions = OpenOptions(4)
    let readOnly: OpenOptions = OpenOptions(8)
    let all: OpenOptions = OpenOptions(15)
}

// `Device.setPowerState`.
public enum PowerState: U32 {
    Auto = 0
    On = 1
    Suspended = 2
}

// ─── Surfaces (§9.2) ────────────────────────────────────────────────────────

public distinct SurfaceUsage = U32

public namespace SurfaceUsage {
    let none: SurfaceUsage = SurfaceUsage(0)
    let render: SurfaceUsage = SurfaceUsage(1)
    let sample: SurfaceUsage = SurfaceUsage(2)
    let scanout: SurfaceUsage = SurfaceUsage(4)
    let cpuRead: SurfaceUsage = SurfaceUsage(8)
    let cpuWrite: SurfaceUsage = SurfaceUsage(16)
    let videoDecode: SurfaceUsage = SurfaceUsage(32)
    let videoEncode: SurfaceUsage = SurfaceUsage(64)
    let camera: SurfaceUsage = SurfaceUsage(128)
    let protectedContent: SurfaceUsage = SurfaceUsage(256)
}

// `SurfaceDescriptor.flags` and `SurfaceInfo.flags`.
public distinct SurfaceFlags = U32

public namespace SurfaceFlags {
    let none: SurfaceFlags = SurfaceFlags(0)
    let purgeable: SurfaceFlags = SurfaceFlags(1)
    // `SurfaceDescriptor`: physically contiguous memory.
    let contiguous: SurfaceFlags = SurfaceFlags(2)
    // `SurfaceInfo`: the contents were discarded.
    let purged: SurfaceFlags = SurfaceFlags(2)
    let imported: SurfaceFlags = SurfaceFlags(4)
    let adopted: SurfaceFlags = SurfaceFlags(8)
}

// `Surface.lock`'s access.
public distinct SurfaceAccess = U32

public namespace SurfaceAccess {
    let none: SurfaceAccess = SurfaceAccess(0)
    let read: SurfaceAccess = SurfaceAccess(1)
    let write: SurfaceAccess = SurfaceAccess(2)
}

// A surface request. RIDL has no fixed arrays, so the four acceptable
// modifiers are four fields.
@Derive(Copy)
public struct SurfaceDescriptor {
    var width: UN32
    var height: UN32
    var format: FourCc
    var usage: SurfaceUsage
    var gpu: EntryId
    var modifierCount: UN32
    var flags: SurfaceFlags
    var modifier0: Modifier
    var modifier1: Modifier
    var modifier2: Modifier
    var modifier3: Modifier
}

@Derive(Copy)
public struct SurfacePlane {
    var offset: UNumber
    var stride: UN32
    var size: UNumber
}

@Derive(Copy)
public struct SurfaceInfo {
    var width: UN32
    var height: UN32
    var format: FourCc
    var usage: SurfaceUsage
    var modifier: Modifier
    var planeCount: UN32
    var flags: SurfaceFlags
    var plane0: SurfacePlane
    var plane1: SurfacePlane
    var plane2: SurfacePlane
    var plane3: SurfacePlane
}

public enum NativeKind: U32 {
    None = 0
    DmaBufFd = 1
    SyncFileFd = 2
    DrmSyncobjFd = 3
    MachPort = 4
}

