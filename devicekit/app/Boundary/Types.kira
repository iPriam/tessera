    let forceUnitAccess: BlockWriteFlags = BlockWriteFlags(1)
}

// `MapperTarget.kind`.
public enum MapperTargetKind: U32 {
    Linear = 1
    Verity = 2
    Crypt = 3
}

// `Mapper.create` flags.
public distinct MapperFlags = U32

public namespace MapperFlags {
    let none: MapperFlags = MapperFlags(0)
    let readOnly: MapperFlags = MapperFlags(1)
}

// `Mapper.status`: these bits, and the device's open count in the high
// half.
public distinct MapperStatus = U32

public namespace MapperStatus {
    let none: MapperStatus = MapperStatus(0)
    let active: MapperStatus = MapperStatus(1)
    let suspended: MapperStatus = MapperStatus(2)
    let readOnly: MapperStatus = MapperStatus(4)
}

// ─── Usb (§17.2) ────────────────────────────────────────────────────────────

// `UsbTransfer.type`.
public enum UsbTransferKind: U32 {
    Control = 1
    Bulk = 2
    Interrupt = 3
    Isochronous = 4
}

@Derive(Copy)
public struct UsbTransfer {
    var endpoint: UN32
    var transferType: UsbTransferKind
    var buffer: Buffer
    var timeout: UNumber
    var setup: UNumber
    var flags: UN32
}
