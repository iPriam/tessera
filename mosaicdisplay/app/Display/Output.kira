import Foundation
import Heap
import LibTessera
import DeviceKit

// Finding the display and what would drive it, through DeviceKit.
//
// The registry names the display controller; the device manager opens it for
// this program as DRM master; `Display.resources` answers what it has. A
// connector is where the picture leaves the machine, a CRTC is what scans it
// out and a plane is what the CRTC reads pixels from, and the first connected
// connector, a CRTC it can be driven by and that CRTC's primary plane are all
// it takes.

// What would drive the display: a connected connector, the size and refresh
// of its preferred mode and the scale it is drawn at, a CRTC that can drive it
// and a primary plane for that CRTC.
struct Scanout {
    var connector: UN32
    var crtc: CrtcId
    var plane: UN32
    // The CRTC's cursor plane, on a display that has one.
    var cursorPlane: UN32? = .None
    var width: Number
    var height: Number
    // Millihertz.
    var refresh: Number
    // Pixels a point, along each side (OutputScale).
    var scale: Number
}

extend Scanout {
    // The output's size in points, which is what every surface is placed,
    // configured and hit-tested in.
    function pointWidth(borrow self) -> Number {
        return trunc(width / scale)
    }

    function pointHeight(borrow self) -> Number {
        return trunc(height / scale)
    }
}

// The display this program holds, and the port its flips complete on.
//
// `device` is never closed on purpose: closing the last reference to a DRM
// master hands the console its mode back, and takes the picture with it.
struct Display {
    var device: Ref
    var flips: Handle
    var scanout: Scanout
    // What is on the screen now, kept until a later flip replaces it.
    var shown: Shown?
    // The cursor, once it is drawn on the cursor plane.
    var cursor: Cursor? = .None
    // The serial of the flip committed and not yet on the screen, one at a
    // time, and what the screen showed before it, let go of once it lands.
    var flipping: UNumber? = .None
    var retiring: Shown? = .None
    // Whether the cursor moved while a flip was in flight; its plane is
    // committed again once the flip lands.
    var cursorLate: Bool = false
}

// `MatchSpec`: the class @0, then family, flags and no constraints. The
// answer is a count, then one 48-byte record per entry, its id first.
namespace RegistryMatch {
    let specBytes: Number = 16
    let listBytes: Number = 16384
    let recordsAt: Number = 8
    let recordBytes: Number = 48
}

namespace OpenKey {
    let display: UNumber = UNumber(1)
    let input: UNumber = UNumber(3)
}

// The entries of `entryClass` the registry names.
function entriesOf(entryClass: borrow EntryClass) -> Result<[EntryId], TesseraError> {
    let spec = zeroedBlock(count: RegistryMatch.specBytes, alignment: 16)
    let list = zeroedBlock(count: RegistryMatch.listBytes, alignment: 16)
    heapStore(
        spec.pointer(),
        MatchSpecRecord {
            entryClass: entryClass,
            family: Family.None,
            flags: UN32(0),
            count: UN32(0)
        }
    )
    let count = try registryMatch(
        Buffer { address: spec.pointer(), length: RegistryMatch.specBytes },
        Buffer { address: list.pointer(), length: RegistryMatch.listBytes }
    )
    var entries: [EntryId] = []
    for index in 0..count {
        let record: EntryInfoRecord = heapLoad(
            list.pointer(),
            RegistryMatch.recordsAt + index * RegistryMatch.recordBytes
        )
        entries.append(EntryId(record.id))
    }
    return .Ok(entries)
}

// Opens `entry` through the device manager, waiting on `port` for its answer.
function openEntry(
    entry: EntryId,
    family: borrow Family,
    options: OpenOptions,
    port: Handle,
    key: UNumber
) -> Result<Ref, TesseraError> {
    try deviceOpen(entry, family, options, port, key)
    let opened = try awaitAnswer(port)
    return .Ok(Ref(opened.result0))
}

// Opens the first display controller the registry names, as master.
function openDisplay(port: Handle) -> Result<Ref, TesseraError> {
    let entries = try entriesOf(.DisplayController)
    if entries.count == 0 { return .Error(failure(.NotFound)) }
    return openEntry(entries[0], .Display, OpenOptions.master, port, OpenKey.display)
}

// Reads the display's resources and picks what would drive it.
function findScanout(device: Ref) -> Result<Scanout?, TesseraError> {
    var bytes = zeroedBlock(count: Resources.initialBytes, alignment: 16)
    match displayResources(
        device,
        Buffer { address: bytes.pointer(), length: Number(bytes.count) }
    ) {
        Ok -> return .Ok(chooseScanout(bytes))
        Error(reason) -> return resizedResources(device, bytes, reason)
    }
}

function resizedResources(device: Ref, bytes: borrow mut ByteBlock, reason: borrow TesseraError) -> Result<Scanout?, TesseraError> {
    if reason.code != .BufferTooSmall || reason.detail <= UNumber(bytes.count) { return .Error(reason) }
    bytes.resize(Number(reason.detail))
    try displayResources(device, Buffer { address: bytes.pointer(), length: Number(bytes.count) })
    return .Ok(chooseScanout(bytes))
}

// A `Resources` block: a `ResourcesHeader`, then each connector with its
// modes, each CRTC, and each plane with its format pairs.
namespace Resources {
    let initialBytes: Number = 16384
    let headerBytes: Number = 16
    let connectorBytes: Number = 32
    let modeBytes: Number = 48
    let crtcBytes: Number = 16
    let planeBytes: Number = 24
    let formatBytes: Number = 16
}

// `ConnectorInfo.state`.
@Derive(Copy)
enum ConnectorState: UN32 {
    Disconnected = 0
    Connected = 1
    Unknown = 2
}

let connectorStates: [ConnectorState] = [ConnectorState.Disconnected, ConnectorState.Connected, ConnectorState.Unknown]

// `PlaneInfo.type`.
@Derive(Copy)
enum PlaneKind: UN32 {
    Primary = 0
    Cursor = 1
    Overlay = 2
}

let planeKinds: [PlaneKind] = [PlaneKind.Primary, PlaneKind.Cursor, PlaneKind.Overlay]

function isConnected(connector: borrow ConnectorInfoHead) -> Bool {
    return match caseWithCode(connectorStates, connector.state) {
        Some(state) -> state == .Connected
        None -> false
    }
}

function isPrimary(plane: borrow PlaneInfoHead) -> Bool {
    return isKind(plane, .Primary)
}

function isKind(plane: borrow PlaneInfoHead, wanted: borrow PlaneKind) -> Bool {
    return match caseWithCode(planeKinds, plane.kind) {
        Some(kind) -> kind == wanted
        None -> false
    }
}

function hasBit(mask: UN32, index: Number) -> Bool {
    return (mask & (UN32(1) << UN32(index))) != UN32(0)
}

// A connected connector with a mode: its id, the CRTCs it can reach and its
// preferred mode's size.
struct Output {
    var connector: UN32
    var reachable: UN32
    var width: Number
    var height: Number
    var refresh: Number
    // The panel's size, in millimetres; zero when the display does not say.
    var widthMm: Number
}

// How many pixels a point is on an output, as a Mac draws a Retina display at
// two. A boot names the scale its window is drawn at in TESSERA_OUTPUT_SCALE,
// since a virtual display has no size to measure it from. Otherwise it is two
// once the panel holds 192 pixels an inch or more, twice the 96 a point stands
// for, and one for a display that does not say its size.
namespace OutputScale {
    let denseInch: Number = 192
    let millimetresAnInch: Number = 25.4
    let variable: String = "TESSERA_OUTPUT_SCALE"
}

function outputScale(output: borrow Output) -> Number {
    if environmentIsSet(OutputScale.variable) {
        let named = try environmentValue(OutputScale.variable).toNumber() otherwise return 1
        return named >= 2 ? 2 : 1
    }
    if output.widthMm > 0 {
        let perInch = output.width * OutputScale.millimetresAnInch / output.widthMm
        return perInch >= OutputScale.denseInch ? 2 : 1
    }
    return 1
}

// The first connected connector with a mode.
function chooseOutput(block: borrow ByteBlock, count: Number) -> Output? {
    var at = Resources.headerBytes
    for index in 0..count {
        let connector: ConnectorInfoHead = heapLoad(block.pointer(), at)
        if connector.modeCount > 0 && isConnected(connector) {
            // The first mode is the one the connector prefers.
            let mode: ModeRecord = heapLoad(block.pointer(), at + Resources.connectorBytes)
            return .Some(
                Output {
                    connector: connector.id,
                    reachable: connector.crtcMask,
                    width: mode.width,
                    height: mode.height,
                    refresh: mode.refreshMilliHz,
                    widthMm: connector.widthMm,
                }
            )
        }
        at += Resources.connectorBytes + connector.modeCount * Resources.modeBytes
    }
    return .None
}

// The offset past every connector.
function connectorsEnd(block: borrow ByteBlock, count: Number) -> Number {
    var at = Resources.headerBytes
    for index in 0..count {
        let connector: ConnectorInfoHead = heapLoad(block.pointer(), at)
        at += Resources.connectorBytes + connector.modeCount * Resources.modeBytes
    }
    return at
}

// A CRTC and its index, which planes name it by.
struct Crtc {
    var id: CrtcId
    var index: Number
}

function chooseCrtc(block: borrow ByteBlock, at: Number, count: Number, reachable: UN32) -> Crtc? {
    for index in 0..count {
        let crtc: CrtcInfoRecord = heapLoad(block.pointer(), at + index * Resources.crtcBytes)
        if hasBit(reachable, crtc.index) {
            return .Some(Crtc { id: CrtcId(crtc.id), index: crtc.index })
        }
    }
    return .None
}

function choosePlane(
    block: borrow ByteBlock,
    at: Number,
    count: Number,
    crtc: borrow Crtc
) -> UN32? {
    return planeOfKind(block, at, count, crtc, .Primary)
}

// Records every plane the display offers: its id, its kind and the CRTCs it
// can be read by, which is what a missing cursor or overlay is told by.
function reportPlanes(block: borrow ByteBlock, at: Number, count: Number) {
    var record = at
    for index in 0..count {
        let plane: PlaneInfoHead = heapLoad(block.pointer(), record)
        log info(
            "the display offers a plane",
            plane: plane.id,
            kind: plane.kind,
            crtcs: plane.crtcMask
        )
        record += Resources.planeBytes + plane.formatCount * Resources.formatBytes
    }
}

// The first plane of `kind` the CRTC can read from.
function planeOfKind(
    block: borrow ByteBlock,
    at: Number,
    count: Number,
    crtc: borrow Crtc,
    kind: borrow PlaneKind
) -> UN32? {
    var record = at
    for index in 0..count {
        let plane: PlaneInfoHead = heapLoad(block.pointer(), record)
        if isKind(plane, kind) && hasBit(plane.crtcMask, crtc.index) { return .Some(plane.id) }
        record += Resources.planeBytes + plane.formatCount * Resources.formatBytes
    }
    return .None
}

function chooseScanout(block: borrow ByteBlock) -> Scanout? {
    let header: ResourcesHeader = heapLoad(block.pointer())
    let connectors = Number(header.connectors)
    let crtcs = Number(header.crtcs)
    let planes = Number(header.planes)
    let output = match chooseOutput(block, connectors) {
        Some(value) -> value
        None -> {
            log warn("no connector is connected with a mode")
            return .None
        }
    }
    let crtcsAt = connectorsEnd(block, connectors)
    let crtc = match chooseCrtc(block, crtcsAt, crtcs, output.reachable) {
        Some(value) -> value
        None -> {
            log warn("no CRTC can drive the connector", connector: output.connector)
            return .None
        }
    }
    let plane = match choosePlane(block, crtcsAt + crtcs * Resources.crtcBytes, planes, crtc) {
        Some(value) -> value
        None -> {
            log warn("the CRTC has no primary plane", crtc: crtc.id.raw)
            return .None
        }
    }
    reportPlanes(block, crtcsAt + crtcs * Resources.crtcBytes, planes)
    let cursorPlane = planeOfKind(
        block,
        crtcsAt + crtcs * Resources.crtcBytes,
        planes,
        crtc,
        .Cursor
    )
    log info(
        "chose an output",
        connector: output.connector,
        crtc: crtc.id.raw,
        plane: plane,
        cursor: cursorPlane.isSome(),
        width: output.width,
        height: output.height,
        refresh: output.refresh,
        scale: outputScale(output)
    )
    return .Some(
        Scanout {
            connector: output.connector,
            crtc: crtc.id,
            plane: plane,
            cursorPlane: cursorPlane,
            width: output.width,
            height: output.height,
            refresh: output.refresh,
            scale: outputScale(output)
        }
    )
}
