// The release file's text: the version and the machine a system reports in
// its `KEY="value"` release file. Kept apart from the About app so the parsing
// runs in host tests, with no system file or platform library in reach.
construct ReleaseText extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .Library
    let moduleRoot: String = "ReleaseText"
}
