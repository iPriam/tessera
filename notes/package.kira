//! Notes: lines typed and kept between launches, in the application's own data
//! folder.
//!
//! Kira UI draws it and puts it on Tessera's display.
/// The Notes app package: notes kept between launches.
construct NotesApp extends Package {
    let version: String = "26.10.4"
    let kind: PackageKind = .App
    // Its icon, light and dark, which the platform shows wherever the
    // application is.
    let assets: [String] = ["Resources/AppIcon.tessicon"]
    let moduleRoot: String = "Notes"
}
