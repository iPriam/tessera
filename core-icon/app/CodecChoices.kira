import Foundation
import Kten

// A choice in Kten: its light value alone when it has no other, else
// `Choice { light: …, dark: …, mono: … }` with the appearances it sets.

namespace ChoiceTag {
    let name: String = "Choice"
}

// The light, dark and mono values a choice is written with.
function choiceParts(value: borrow Kten) -> Result<(Kten, Kten?, Kten?), IconReadFailure> {
    let tagged = match value {
        Object(object) -> match object.tag {
            Some(tag) -> tag == ChoiceTag.name
            None -> false
        }
        // A value that is not an object is the light value alone.
        Null, Bool, Number, Text, Bytes, List, Case -> false
    }
    if !tagged { return .Ok((copy value, .None, .None)) }
    let light = match try fieldIn(value, "light") {
        Some(light) -> light
        None -> return .Error(.Shape(.Absent("light")))
    }
    return .Ok((light, try fieldIn(value, "dark"), try fieldIn(value, "mono")))
}

function choiceKten(light: Kten, dark: Kten?, mono: Kten?) -> Kten {
    if dark.isNone() && mono.isNone() { return light }
    var fields = [ktenField("light", move light)]
    match dark {
        Some(value) -> fields.append(ktenField("dark", move value))
        // The dark appearance takes the light value.
        None -> {}
    }
    match mono {
        Some(value) -> fields.append(ktenField("mono", move value))
        // The mono appearance takes the dark or light value.
        None -> {}
    }
    return ktenObject(ChoiceTag.name, move fields)
}

function boolKten(flag: Bool) -> Kten {
    return .Bool(flag)
}

function numberKten(number: Number) -> Kten {
    return .Number(number)
}

function optionalBoolChoiceValue(value: borrow Kten?) -> Result<Bool?, IconReadFailure> {
    return match value {
        Some(present) -> .Ok(.Some(try boolIn(present)))
        None -> .Ok(.None)
    }
}

function boolChoiceIn(value: borrow Kten) -> Result<BoolChoice, IconReadFailure> {
    let (light, dark, mono) = try choiceParts(value)
    return .Ok(
        BoolChoice {
            light: try boolIn(light),
            dark: try optionalBoolChoiceValue(dark),
            mono: try optionalBoolChoiceValue(mono)
        }
    )
}

function boolChoiceKten(choice: borrow BoolChoice) -> Kten {
    let dark: Kten? = match choice.dark {
        Some(value) -> .Some(boolKten(value))
        None -> .None
    }
    let mono: Kten? = match choice.mono {
        Some(value) -> .Some(boolKten(value))
        None -> .None
    }
    return choiceKten(boolKten(choice.light), move dark, move mono)
}

// The choice in `object`'s field `name`, or `fallback` when it is left out.
function boolChoiceField(
    object: borrow Kten,
    name: borrow String,
    fallback: borrow BoolChoice
) -> Result<BoolChoice, IconReadFailure> {
    return match try fieldIn(object, name) {
        Some(value) -> boolChoiceIn(value)
        None -> .Ok(copy fallback)
    }
}

