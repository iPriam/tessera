// `tessicon`: CoreIcon on the command line. Renders a `.tessicon` in an
// appearance, or one SVG, into a PNG, to look at what the pipeline draws.
construct Tessicon extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .App
    let dependencies: [Dependency] = [
        Dependency { name: "CoreIcon", path: "../.." },
        Dependency { name: "ArgumentParser", path: "../../../argument-parser" }
    ]
}
