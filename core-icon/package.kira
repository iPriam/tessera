// CoreIcon: Tessera's icon pipeline. It reads and writes the `.tessicon`
// documents Icon Composer makes, a folder holding `icon.json` and the layers'
// artwork in `Assets/`, and renders them as the system shows an application's
// icon: layers in groups, each group a piece of Liquid Glass with its
// specular edge, frosted translucency and shadow, over the icon's background,
// in the light, dark and mono appearances.
//
// It renders as Apple's IconRendering does, pass by pass through RenderBox
// on the GPU, so the build renders every application's icon on the host, as
// Xcode's asset compiler does, and Icon Composer renders the one it edits on
// the machine, both to the pixel the system shows.
construct CoreIconLibrary extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .Library
    let moduleRoot: String = "CoreIcon"
    let dependencies: [Dependency] = [
        Dependency { name: "RenderBox", path: "../krenderbox" },
        Dependency { name: "Ember", path: "../ember" }
    ]
}
