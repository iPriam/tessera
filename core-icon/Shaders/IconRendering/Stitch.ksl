// What every IconRendering function shares: the triangle that runs it over
// the whole target, the point being shaded, and the distance field's
// encoding. A stage's input and output types cannot come from an import, so
// each shader declares its own.
//
// The functions are IconRendering's default.metallib (iOS 27.0.1), rebuilt
// from its AIR, one KSL shader each, written to the contract RenderBox's
// `ShaderFill.kira` describes. Metal computes them in half precision; KSL
// has no half type, so these compute in float.

// The smallest width a fragment's change is taken as: half's 2^-10.
const smallestWidth: Float = 0.0009765625
// The widest a fragment's change is taken as.
const widestWidth: Float = 2.0
// Antialiasing spans 5/6 of a pixel's change, centred: 5/12 either side.
const antialiasSpan: Float = 0.8333333333333334
const antialiasHalfSpan: Float = 0.4166666666666667

// One triangle over the target: (-1, -1), (3, -1) and (-1, 3), as clip
// positions by vertex index.
function fullscreen(vid: UInt) -> Float4 {
    let corner = Float2(-1.0, -1.0)
    if vid == UInt(1) {
        corner.x = 3.0
    }
    if vid == UInt(2) {
        corner.y = 3.0
    }
    return Float4(corner, 0.0, 1.0)
}

// The point a device pixel shades, in the shader's user space.
function userPoint(device: Float2, toUser: Float4, translation: Float2) -> Float2 {
    return toUser.xy * device.x + toUser.zw * device.y + translation
}

function saturate(x: Float) -> Float {
    return clamp(x, 0.0, 1.0)
}

// smoothstep(0, 1, x) written out: x * x * (3 - 2x), x clamped to [0, 1].
function smooth01(x: Float) -> Float {
    let c = saturate(x)
    return c * c * (3.0 - 2.0 * c)
}

// A fragment's change in `value`, kept between half's smallest step and two.
function changeWidth(value: Float) -> Float {
    return clamp(fwidth(value), smallestWidth, widestWidth)
}

// The distance field's distance in points, positive inside the shape:
// (sdfZero - r) * sdfScale.
function insideDistance(texel: Float4, sdfScale: Float, sdfZero: Float) -> Float {
    return (sdfZero - texel.x) * sdfScale
}

// The field's outward normal, stored in g and b as (1 - n) / 2.
function outwardNormal(texel: Float4) -> Float2 {
    return Float2(1.0, 1.0) - texel.yz * 2.0
}
