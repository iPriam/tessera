TessIcon {
    fill: .Automatic,
    groups: [
        Group {
            name: "Panes",
            layers: [
                Layer { name: "Upper pane", image: "pane-upper.svg", fill: Choice { light: .AutomaticGradient(Color { space: .Srgb, red: 0.86, green: 0.55, blue: 0.38, alpha: 1 }), dark: .AutomaticGradient(Color { space: .Srgb, red: 0.62, green: 0.38, blue: 0.26, alpha: 1 }), mono: .Solid(Color { space: .Srgb, red: 1, green: 1, blue: 1, alpha: 1 }) }, visible: false },
                Layer { name: "Lower pane", image: "pane-lower.svg", fill: Choice { light: .AutomaticGradient(Color { space: .Srgb, red: 0.86, green: 0.55, blue: 0.38, alpha: 1 }), dark: .AutomaticGradient(Color { space: .Srgb, red: 0.62, green: 0.38, blue: 0.26, alpha: 1 }), mono: .Solid(Color { space: .Srgb, red: 1, green: 1, blue: 1, alpha: 1 }) }, visible: false },
                Layer { name: "Left pane", image: "pane-left.svg", fill: Choice { light: .AutomaticGradient(Color { space: .Srgb, red: 0.86, green: 0.55, blue: 0.38, alpha: 1 }), dark: .AutomaticGradient(Color { space: .Srgb, red: 0.62, green: 0.38, blue: 0.26, alpha: 1 }), mono: .Solid(Color { space: .Srgb, red: 1, green: 1, blue: 1, alpha: 1 }) }, visible: false },
                Layer { name: "Strips", image: "strips.svg", fill: Choice { light: .AutomaticGradient(Color { space: .Srgb, red: 0.86, green: 0.55, blue: 0.38, alpha: 1 }), dark: .AutomaticGradient(Color { space: .Srgb, red: 0.62, green: 0.38, blue: 0.26, alpha: 1 }), mono: .Solid(Color { space: .Srgb, red: 1, green: 1, blue: 1, alpha: 1 }) }, visible: true }
            ],
            lighting: .Individual,
            specular: .Inside,
            translucency: Translucency { enabled: true, amount: 0.5 },
            shadow: Shadow { kind: .None, opacity: 0 }
        }
    ]
}
