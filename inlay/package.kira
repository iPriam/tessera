// Inlay: the person's documents and the folders of every volume, with New
// Folder, Rename, Duplicate, Copy, Move and Delete Immediately; the disk
// images opened in /Volumes and the applications on them, which open from
// there or install in /Applications; and the applications installed from one,
// which uninstall.
//
// Kira UI draws it and puts it on Tessera's display.
construct InlayApp extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .App
    // Its icon, light and dark, which the platform shows wherever the
    // application is.
    let assets: [String] = ["Resources/AppIcon.tessicon"]
    let moduleRoot: String = "Inlay"
    let dependencies: [Dependency] = [Dependency { name: "FileOperations", path: "operations" }]
}
