//! The C layout of the kernel's process information record, which caffeinate reads a utility's end from.
import Foundation

/// The kernel's process information record, laid out as C lays it out, read by `objectInfo` for a process.
@FFI.Struct { layout: c }
struct ProcessInfoRecord {
    var processId: U64
    var jobId: U64
    var appId: U64
    var state: U32
    var isMain: U8
    var reserved0: Reserved3
    var exitCode: Int
    var startTime: U64
    var cpuTime: U64
    var threadCount: U32
    var handleCount: U32
    var residentBytes: U64
    var mappedBytes: U64
    var terminationReason: U32
    var reserved1: U32
    var reserved2: U64
}

/// Three reserved bytes of the process information record, kept so the later fields sit where the kernel puts them.
@FFI.Array { element: U8, count: 3 }
struct Reserved3 {}
