import Foundation
import TesseraUI
import Heap
import LibTessera
import KiraUI

// Devices that come and go, as the platform hears of them on its System
// channel (roadmap/16-libtessera.md §12 `deviceChanged`), the way the menu
// bar's sound menu follows Core Audio's device list, and volumes mounted
// and unmounted (`volumeChanged`), as the Finder hears of them from
// NSWorkspace, and the clock being set (`timeChanged`, Clock.kira).
//
// Kira UI runs the platform's session and waits on its port; the platform arms
// its System channel there (`armSystem`) and reads the channel's events when
// that wait completes (`systemWoke`).

// What the platform watches besides the display: its System channel while it
// has one, the devices it has heard of and the port devices are listed on,
// and whether the System channel's wait is armed. A wait that has not
// completed stays armed for the next turn.
struct Watch {
    var system: Handle?
    var devices: [ListedDevice]
    var devicePort: Handle?
    var systemArmed: Bool
    // The settings `System/settingsChanged` named since they were last
    // followed (Idle.kira).
    var settingsChanged: [String] = []
}

// The key of the System channel's wait on the session's port, the first of
// the platform's own (`DynamicPlatformWaitKey`).
namespace WatchKey {
    let system: Number = DynamicPlatformWaitKey.base
}

// How long `Device.list` may take to answer.
namespace DeviceList {
    let bytes: Number = 8192
    let key: Number = 1
    let wait: Number = 2000000000
}

// The System channel init handed the platform, or none.
function systemChannel() -> Handle? { return startupHandle(StartupTag.system) }

// A port to wait on, or none, said, when there is no port to be had.
function newPort(purpose: borrow String) -> Handle? {
    match portCreate(.None) {
        Ok(port) -> return .Some(port)
        Error(failed) -> {
            log warn("no port", purpose, error: errorName(failed))
            return .None
        }
    }
}

function watchDevices() -> Watch {
    let system = systemChannel()
    match system {
        // The time it shows from now on, which a clock set before the
        // channel was had is not posted to it as a change.
        Some -> log info(
            "watching for devices",
            now: utcText(unixMillis() * Realtime.nanosecondsPerMillisecond)
        )
        None -> log warn("no System channel; devices that come and go are not shown")
    }
    return Watch {
        system: system,
        devices: [],
        devicePort: newPort("to list devices on"),
        systemArmed: false,
    }
}

function deviceClassName(deviceClass: borrow DeviceClass) -> String {
    match deviceClass {
        Sensor -> return "sensor"
        AudioInput -> return "audio input"
        AudioOutput -> return "audio output"
        Camera -> return "camera"
        Haptic -> return "haptic device"
    }
}

// The name of a device the platform has heard of, so one that goes is named
// although the Devices service no longer lists it, as Core Audio's clients
// keep a device's name from when it came.
function knownName(devices: borrow [ListedDevice], id: Number) -> String? {
    for device in devices {
        if device.id == id { return .Some(device.name) }
    }
    return .None
}

// The name `Device.list` gives the device `id` of `deviceClass`, when it
// lists it.
function listedName(port: Handle, deviceClass: DeviceClass, id: Number) -> String? {
    let block = zeroedBlock(count: DeviceList.bytes, alignment: 16)
    let listed = match deviceList(
        move deviceClass,
        Buffer { address: block.pointer(), length: DeviceList.bytes },
        port,
        DeviceList.key
    ) {
        Ok -> completion(port, DeviceList.key, DeviceList.wait)
        Error(failed) -> .Error(failed)
    }
    match listed {
        Ok -> {}
        Error(failed) -> {
            log warn("cannot list devices", error: errorName(failed))
            return .None
        }
    }
    return knownName(listedDevicesOf(block.pointer(), DeviceList.bytes), id)
}

// A device came or went: name it, from what the platform heard before or from
// the Devices service's list.
function deviceChanged(watch: borrow mut Watch, change: borrow DeviceChange) {
    let deviceClass = match change.deviceClass {
        Some(value) -> value
        None -> {
            log warn("a device of an unknown class changed", id: change.id)
            return
        }
    }
    let kind = deviceClassName(deviceClass)
    var name = knownName(watch.devices, change.id)
    if change.added && name.isNone() {
        match watch.devicePort {
            Some(port) -> name = listedName(port, move deviceClass, change.id)
            // With no port to list on, the device goes unnamed.
            None -> {}
        }
        match name {
            Some(listed) -> watch.devices.append(ListedDevice { id: change.id, name: listed })
            // The Devices service does not list it; it stays unnamed.
            None -> {}
        }
    }
    let said = match name {
        Some(value) -> value
        None -> "an unnamed device"
    }
    if change.added { log info("a device was added", kind, name: said) } else {
        log info("a device was removed", kind, name: said)
    }
}

function volumeChanged(change: borrow VolumeChange) {
    if change.mounted { log info("a volume was mounted", path: change.path) } else {
        log info("a volume was unmounted", path: change.path)
    }
}

// Every event the System channel holds now; the channel is dropped, and
// asked for again, once it closes.
function readSystemEvents(watch: borrow mut Watch) {
    let system = match watch.system {
        Some(value) -> value
        None -> return
    }
    let block = zeroedBlock(count: SystemMessage.bytes, alignment: 16)
    while true {
        let received = match channelRead(
            system,
            Buffer { address: block.pointer(), length: SystemMessage.bytes },
            SystemMessage.handles
        ) {
            Ok(value) -> value
            Error(failed) -> {
                systemReadFailed(watch, failed)
                return
            }
        }
        // The platform keeps none of the handles an event carries.
        releaseAll(received.handles)
        match settingsChangedIn(block.pointer(), received.bytes) {
            Some(key) -> {
                watch.settingsChanged.append(key)
                continue
            }
            None -> {}
        }
        match systemNoticeOf(block.pointer(), received.bytes) {
            Some(event) -> match event {
                DeviceChanged(change) -> deviceChanged(watch, change)
                TimeChanged(offset) -> clockSet(offset)
                VolumeChanged(change) -> volumeChanged(change)
            }
            // A message the platform does not follow.
            None -> {}
        }
    }
}

// The System channel could not be read: nothing more is there for now, the
// broker went, or the channel failed.
function systemReadFailed(watch: borrow mut Watch, failed: borrow TesseraError) {
    // Nothing more is there; the channel's wait is armed again.
    if failed.code == .ShouldWait { return }
    watch.systemArmed = false
    if failed.code == .PeerClosed {
        // The broker went; init starts it again.
        log warn("the System channel closed; connecting again")
        watch.system = systemChannel()
        match watch.system {
            Some -> log info("watching for devices again")
            // Without a channel there is nothing more to say.
            None -> {}
        }
        return
    }
    watch.system = .None
    log warn("cannot read the System channel", error: errorName(failed))
}

// Closes the handles a message carried.
function releaseAll(handles: borrow [Handle]) {
    if handles.count == 0 { return }
    match handleCloseMany(handles) {
        Ok -> {}
        Error(failed) -> log warn(
            "could not close the handles a message carried",
            error: errorName(failed)
        )
    }
}

// Arms the System channel's wait on the session's `port`, unless it is armed.
function armSystem(watch: borrow mut Watch, port: Handle) {
    if watch.systemArmed { return }
    match watch.system {
        Some(system) -> match objectWaitAsync(
            system,
            Signals.readable | Signals.peerClosed,
            .Once,
            port,
            WatchKey.system
        ) {
            Ok -> watch.systemArmed = true
            Error(failure) -> log warn(
                "cannot wait",
                on: "the System channel",
                error: errorName(failure)
            )
        }
        None -> {}
    }
}

// The wait keyed `key` completed: the System channel's has events to read.
function systemWoke(watch: borrow mut Watch, key: Number) {
    if key != WatchKey.system { return }
    watch.systemArmed = false
    readSystemEvents(watch)
}
