import Foundation

// Negating the last number of an expression, and expressions that carry
// their own signs.

@Test
function negatingTheLastNumberFlipsItsSign() {
    expect!(negatingLastNumber("80*12") == "80*-12")
    expect!(negatingLastNumber("-3") == "3")
    expect!(negatingLastNumber("5-3") == "5--3")
}

@Test
function negatingALeadingSignAfterAnOperatorStillWorks() {
    expect!(negatingLastNumber("1+-2") == "1+2")
}

@Test
function negatingNothingOrAnUnclosedGroupIsHandled() {
    expect!(negatingLastNumber("") == "")
    expect!(negatingLastNumber("(2") == "(-2")
}

@Test
function negatedExpressionsEvaluate() {
    expect!(outcome("5-3") == "2")
    expect!(outcome("5--3") == "8")
    expect!(outcome("1+-2") == "-1")
    expect!(outcome("-(2)") == "-2")
}
