//! Clock: the time and the date, in the time zone chosen in Settings.
//!
//! Kira UI draws it and puts it on Tessera's display.
/// The Clock app package: the time, the stopwatch and the timers.
construct ClockApp extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .App
    // Its icon, light and dark, which the platform shows wherever the
    // application is.
    let assets: [String] = ["Resources/AppIcon.tessicon"]
    let moduleRoot: String = "Clock"
}
