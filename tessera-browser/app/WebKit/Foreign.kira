// WebKit's WPE port, GLib and Tessera's WPE platform, as the browser reaches
// them: each an `@FFI.Extern` here, and nowhere else (the WebKit exception in
// tessera/AGENTS.md).
//
// Every object is an opaque `RawPtr`. GLib owns them by reference count, so a
// pointer this program holds is one it took a reference on and gives back with
// `g_object_unref`. The web engine is driven by polling: `g_main_context_iteration`
// is called from the session's own turn, so no GLib code ever runs on a thread
// of its own.

// ---------------------------------------------------------------------------
// GLib
// ---------------------------------------------------------------------------

// Runs what is ready on the default main context, and does not block unless
// `mayBlock` is nonzero. Answers whether it ran anything.
public @FFI.Extern { library: glib, symbol: g_main_context_iteration, abi: c }
function glibMainContextIteration(context: RawPtr, mayBlock: I32): I32

public @FFI.Extern { library: gobject, symbol: g_object_ref, abi: c }
function glibObjectRef(object: RawPtr): RawPtr

public @FFI.Extern { library: gobject, symbol: g_object_unref, abi: c }
function glibObjectUnref(object: RawPtr): Void

// ---------------------------------------------------------------------------
// WPE platform, with Tessera's display
// ---------------------------------------------------------------------------

