import Foundation
import Heap

// Memory objects (§6.2, §6.3).
//
// A Memory object is a kernel memory backing. A shared slice holds its own
// backing for the parent's memory and a window onto it (the state's `offset`
// and `size`); a copy-on-write slice is new memory filled from the parent
// when it is made.

@Derive(Copy)
public distinct MemoryOptions = UNumber

public namespace MemoryOptions {
    let none: MemoryOptions = MemoryOptions(0)
    let resizable: MemoryOptions = MemoryOptions(1)
    let contiguous: MemoryOptions = MemoryOptions(2)
    let deviceShareable: MemoryOptions = MemoryOptions(4)
    let discardable: MemoryOptions = MemoryOptions(8)
    let noCommit: MemoryOptions = MemoryOptions(16)
}

// A window onto the parent, or a snapshot of it, lazily copied.
@Derive(Copy)
public enum SliceOptions: U32 {
    Shared = 0
    CopyOnWrite = 1
}

// Device memory only.
@Derive(Copy)
public enum CachePolicy: U32 {
    Cached = 0
    WriteCombining = 1
    Uncached = 2
}

function pageAligned(value: U64) -> Bool { return value % kernelPageSize() == U64(0) }

// The size of a page, which Memory objects and mappings are made of: 16 KiB
// on ARM64, 4 KiB on x86-64.
public function memoryPageSize() -> UNumber { return kernelPageSize() }

// `size` rounded up to whole pages, as Memory objects and mappings are.
public function memoryPageRound(size: UNumber) -> UNumber {
    let page = kernelPageSize()
    return trunc((size + page - 1) / page) * page
}

// The state of memory `size` bytes long at `offset` in its backing, made
// with `options` from the object `source` (0 for none).
function memoryFresh(size: U64, offset: U64, options: MemoryOptions, source: U64) -> MemoryObject {
    return MemoryObject {
        size: size,
        offset: offset,
        options: options,
        locked: false,
        mapped: false,
        policy: .Cached,
        source: source,
    }
}

// A memory backing of `size` bytes as a Memory object.
function memoryFromBacking(backing: Number, size: U64, options: MemoryOptions) -> Number {
    return objectCreate(.Memory(memoryFresh(size, U64(0), options, U64(0))), backing)
}

// Whether `length` bytes at `offset` lie inside the memory.
function memoryHolds(memory: borrow MemoryObject, offset: U64, length: U64) -> Bool {
    return offset + length <= memory.size && offset + length >= offset
}

// Zero-filled memory of `size` bytes, a multiple of the page size.
public function memoryCreate(
    size: UNumber,
    options: MemoryOptions
) -> Result<Handle, TesseraError> {
    if size == 0 || !pageAligned(size) || options.raw > U32(31) {
        return .Error(failure(.InvalidArgument))
    }
    if options.has(MemoryOptions.contiguous) {
        if !entitlementHeld("tessera.driver") { return .Error(failure(.NotEntitled)) }
        return .Error(failureIn(.Unsupported, .Devices))
    }
    let backing = try kernelMemoryCreate(size, options.has(MemoryOptions.resizable))
    let object = memoryFromBacking(backing, size, options)
    return handleForNew(object, Rights.processDefault | Rights.map)
}

public function memoryResize(memory: Handle, size: UNumber) -> Result<Void, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.manage)
    var memory = try memoryOf(object)
    if !memory.options.has(MemoryOptions.resizable) { return .Error(failure(.BadState)) }
    if memory.source != U64(0) { return .Error(failure(.BadState)) }
    if size == U64(0) || !pageAligned(size) { return .Error(failure(.InvalidArgument)) }
    if size < memory.size && mappingsCover(library.objects[object].id, size) {
        return .Error(failure(.Busy))
    }
    let backing = try backingOf(object)
    try kernelMemoryResize(backing, size)
    memory.size = size
    setMemory(object, move memory)
    return .Ok
}

// A window onto the parent, or a copy of it taken now.
public function memorySlice(
    parent: Handle,
    offset: UNumber,
    length: UNumber,
    options: SliceOptions
) -> Result<Handle, TesseraError> {
    let slot = try resolve(parent, .Memory, Rights.duplicate)
    let source = objectOfSlot(slot)
    if length == 0 || !pageAligned(offset) || !pageAligned(length) {
        return .Error(failure(.InvalidArgument))
    }
    let parent = try memoryOf(source)
    if !memoryHolds(parent, offset, length) { return .Error(failure(.OutOfRange)) }
    let base = parent.offset + offset
    let made = options == .Shared ? memoryWindow(source, base, length) : memoryCopy(
        source,
        base,
        length
    )
    let object = try made
    return handleForNew(object, library.handles[slot].rights)
}

// A new memory object sharing `length` bytes of `source` from `base`.
function memoryWindow(source: Number, base: U64, length: U64) -> Result<Number, TesseraError> {
    let sourceBacking = try backingOf(source)
    let backing = try kernelDuplicate(sourceBacking)
    let window = memoryFresh(length, base, MemoryOptions.none, library.objects[source].id)
    return .Ok(objectCreate(.Memory(move window), backing))
}

// A new memory object holding a copy of `length` bytes of `source` from `base`.
function memoryCopy(source: Number, base: U64, length: U64) -> Result<Number, TesseraError> {
    let backing = try kernelMemoryCreate(length, false)
    let sourceBacking = try backingOf(source)
    match kernelCopyRange(sourceBacking, base, backing, U64(0), length) {
        Ok -> {}
        Error(failed) -> {
            kernelRelease(backing)
            return .Error(failed)
        }
    }
    let copy = memoryFresh(length, U64(0), MemoryOptions.none, library.objects[source].id)
    return .Ok(objectCreate(.Memory(move copy), backing))
}

// Byte-granular copy out of the object, without mapping it.
public function memoryRead(
    memory: Handle,
    offset: UNumber,
    out: borrow Buffer
) -> Result<Void, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.read)
    let memory = try memoryOf(object)
    if !memoryHolds(memory, offset, out.length) { return .Error(failure(.OutOfRange)) }
    let backing = try backingOf(object)
    return kernelReadAt(backing, out.address, out.length, memory.offset + offset)
}

public function memoryWrite(
    memory: Handle,
    offset: UNumber,
    source: borrow Buffer
) -> Result<Void, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.write)
    let memory = try memoryOf(object)
    if !memoryHolds(memory, offset, source.length) { return .Error(failure(.OutOfRange)) }
    let backing = try backingOf(object)
    return kernelWriteAt(backing, source.address, source.length, memory.offset + offset)
}

// Pins a discardable object's contents and answers whether they survived.
// The library never discards, so they always have.
public function memoryLock(memory: Handle) -> Result<Bool, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.write)
    var memory = try memoryOf(object)
    if !memory.options.has(MemoryOptions.discardable) { return .Error(failure(.BadState)) }
    memory.locked = true
    setMemory(object, move memory)
    return .Ok(true)
}

public function memoryUnlock(memory: Handle) -> Result<Void, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.write)
    var memory = try memoryOf(object)
    if !memory.locked { return .Error(failure(.BadState)) }
    memory.locked = false
    setMemory(object, move memory)
    return .Ok
}

// Kernel memory is ordinary cached memory; only device memory has another policy.
public function memorySetCachePolicy(
    memory: Handle,
    policy: CachePolicy
) -> Result<Void, TesseraError> {
    let object = try resolveObject(memory, .Memory, Rights.manage)
    if !entitlementHeld("tessera.driver") { return .Error(failure(.NotEntitled)) }
    var memory = try memoryOf(object)
    if memory.mapped { return .Error(failure(.BadState)) }
    if policy != .Cached { return .Error(failureIn(.Unsupported, .Devices)) }
    memory.policy = policy
    setMemory(object, move memory)
    return .Ok
}

// `MemoryInfo`, 48 bytes.
function memoryInfoWrite(
    object: Number,
    memory: borrow MemoryObject,
    block: RawPtr
) -> Result<U64, TesseraError> {
    heapStore<U64>(block, 0, memory.size)
    match library.objects[object].backing {
        Some(backing) -> {
            let allocated = try kernelAllocatedBytes(backing)
            heapStore<U64>(block, 8, allocated)
        }
        None -> {}
    }
    heapStore<U32>(block, 16, memory.options.raw)
    heapStore<U32>(block, 20, code(memory.policy))
    heapStore<U64>(block, 24, library.objects[object].id)
    heapStore<U64>(block, 32, memory.source)
    return .Ok(48)
}
