import Foundation
import Heap

// Following Settings from a program's System channel: the broker posts
// `System/settingsChanged` with the key of each setting that changed. A
// program arms the channel on the port it waits on (`armSettingsWatch`) and,
// when that wait completes, takes the keys that changed
// (`settingsWatchWoke`), reading each value again itself.

public struct SettingsWatch {
    var system: Handle? = startupHandle(StartupTag.system)
    var armed: Bool = false
}

// A watch on the System channel this process was started with, not armed.
public function settingsWatch() -> SettingsWatch {
    return SettingsWatch {}
}

// The room a read of the System channel takes: the longest event fits.
namespace SettingsWatchMessage {
    let bytes: Number = 256
    let handles: Number = 4
}

// Arms the System channel's wait on `port` under `key`, unless it is armed.
public function armSettingsWatch(watch: borrow mut SettingsWatch, port: Handle, key: UNumber) {
    if watch.armed { return }
    let system = match watch.system {
        Some(value) -> value
        None -> return
    }
    match objectWaitAsync(system, Signals.readable | Signals.peerClosed, .Once, port, key) {
        Ok -> watch.armed = true
        Error(failed) -> log warn("cannot wait on the System channel", error: errorName(failed))
    }
}

// The System channel's wait completed: the keys of the settings that changed,
// in the order they were posted, each once. The watch is to be armed again.
public function settingsWatchWoke(watch: borrow mut SettingsWatch) -> [String] {
    watch.armed = false
    var changed: [String] = []
    let system = match watch.system {
        Some(value) -> value
        None -> return changed
    }
    let block = zeroedBlock(count: SettingsWatchMessage.bytes, alignment: 16)
    while true {
        let received = match channelRead(
            system,
            Buffer { address: block.pointer(), length: SettingsWatchMessage.bytes },
            SettingsWatchMessage.handles
        ) {
            Ok(value) -> value
            Error(failed) -> {
                if failed.code == .ShouldWait { return changed }
                if failed.code == .PeerClosed {
                    // The broker went; init starts it again.
                    log warn("the System channel closed; connecting again")
                    watch.system = startupHandle(StartupTag.system)
                    return changed
                }
                watch.system = .None
                log warn("cannot read the System channel", error: errorName(failed))
                return changed
            }
        }
        // The watch keeps none of the handles an event carries.
        if received.handles.count > 0 {
            match handleCloseMany(received.handles) {
                Ok -> {}
                Error(failed) -> log warn(
                    "could not close the handles a message carried",
                    error: errorName(failed)
                )
            }
        }
        match settingsChangedIn(block.pointer(), received.bytes) {
            Some(setting) -> if !changed.contains(setting) { changed.append(setting) }
            // Only settings are followed here.
            None -> {}
        }
    }
    return changed
}

// The keyboard layout every key is typed through, by its XKB name: `us`,
// `gb`, `de` or `fr`. MosaicDisplay follows it.
public namespace KeyboardSetting {
    let layout: String = "keyboard.layout"
    let fallback: String = "us"
}
