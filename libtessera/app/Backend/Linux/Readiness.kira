import Foundation
import Heap

// Readiness on Linux: `ppoll`. Above this file readiness is the library's
// own bits (`readyReadable` and the rest); here they become `POLL*` and back.

namespace Poll {
    let input: Number = 1
    let priority: Number = 2
    let out: Number = 4
    let error: Number = 8
    let hangUp: Number = 0x10
    let invalid: Number = 0x20
    let readHangUp: Number = 0x2000
}

// The `poll` events for readiness bits.
function pollEvents(ready: Number) -> Number {
    let bits = U64(ready)
    var events: U64 = U64(0)
    if (bits & U64(Ready.readable)) != U64(0) { events = events | U64(Poll.input) }
    if (bits & U64(Ready.priority)) != U64(0) { events = events | U64(Poll.priority) }
    if (bits & U64(Ready.writable)) != U64(0) { events = events | U64(Poll.out) }
    if (bits & U64(Ready.error)) != U64(0) { events = events | U64(Poll.error) }
    if (bits & U64(Ready.hangUp)) != U64(0) { events = events | U64(Poll.hangUp) }
    if (bits & U64(Ready.invalid)) != U64(0) { events = events | U64(Poll.invalid) }
    if (bits & U64(Ready.readHangUp)) != U64(0) { events = events | U64(Poll.readHangUp) }
    return Number(events)
}

// Readiness bits for the `poll` events the kernel reported.
function readyBits(events: Number) -> Number {
    let bits = U64(events)
    var ready: U64 = U64(0)
    if (bits & U64(Poll.input)) != U64(0) { ready = ready | U64(Ready.readable) }
    if (bits & U64(Poll.priority)) != U64(0) { ready = ready | U64(Ready.priority) }
    if (bits & U64(Poll.out)) != U64(0) { ready = ready | U64(Ready.writable) }
    if (bits & U64(Poll.error)) != U64(0) { ready = ready | U64(Ready.error) }
    if (bits & U64(Poll.hangUp)) != U64(0) { ready = ready | U64(Ready.hangUp) }
    if (bits & U64(Poll.invalid)) != U64(0) { ready = ready | U64(Ready.invalid) }
    if (bits & U64(Poll.readHangUp)) != U64(0) { ready = ready | U64(Ready.readHangUp) }
    return Number(ready)
}

// The readiness `backing` reports now, or 0 when it reports none.
function kernelReady(backing: Number, ready: Number) -> Number {
    // Nothing but room to write, seen this pass, stands: a backing that
    // becomes readable since is found by the wait that follows the pass. One
    // seen readable is asked again, since an operation in the pass may have
    // read it empty.
    for index in 0..library.readyPolled.count {
        if library.readyPolled[index] == backing {
            let events = library.readyEvents[index]
            if events == 0 { return 0 }
            if events == Poll.out { return Number(U64(ready) & U64(Ready.writable)) }
            break
        }
    }
    let blockBytes = zeroedBlock(count: 24, alignment: 16)
    let block = blockBytes.pointer()
    heapStore<U32>(block, 16, U32(backing))
    heapStore<U16>(block, 20, U16(pollEvents(ready)))
    var answer = ppoll(heapOffset(block, 16), U64(1), block, nullPointer())
    while failedWith(answer, .Interrupted) {
        answer = ppoll(heapOffset(block, 16), U64(1), block, nullPointer())
    }
    // Without memory for the poll the kernel reports nothing; every caller
    // looks again.
    if answerFailed(answer) || answer == 0 { return 0 }
    return readyBits(heapLoad<U16>(block, 22))
}

// Sleeps until one of the interests is ready, a signal arrives, or `wait`
// nanoseconds pass (`Deadline.infinite` for no limit). Every caller looks
// again at what it waits on once it wakes, so a wait the kernel cuts short
// only ends the sleep early.
function kernelWaitFor(interests: borrow [Interest], wait: U64) {
    let blockBytes = zeroedBlock(count: 16 + interests.count * 8, alignment: 16)
    let block = blockBytes.pointer()
    var at = 16
    for interest in interests {
        heapStore<U32>(block, at, U32(interest.backing))
        heapStore<U16>(block, at + 4, U16(pollEvents(interest.ready)))
        at += 8
    }
    var timeout = nullPointer()
    if wait != Deadline.infinite {
        storeTimespec(block, U64(0), wait)
        timeout = block
    }
    match answerStatus(ppoll(heapOffset(block, 16), U64(interests.count), timeout, nullPointer())) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
}

// Sleeps until `backing` is ready or `wait` nanoseconds pass.
function kernelWaitOn(backing: Number, ready: Number, wait: U64) {
    kernelWaitFor([Interest { backing: backing, ready: ready }], wait)
}

// Polls every backing in `backings` in one call, so the operations a pass
// steps through look up what each reported instead of polling it alone.
function kernelReadySnapshot(backings: borrow [Number]) {
    kernelReadyForget()
    if backings.count == 0 { return }
    let blockBytes = zeroedBlock(count: 16 + backings.count * 8, alignment: 16)
    let block = blockBytes.pointer()
    let events = Poll.input | Poll.out | Poll.readHangUp
    var at = 16
    for backing in backings {
        heapStore<U32>(block, at, U32(backing))
        heapStore<U16>(block, at + 4, U16(events))
        at += 8
    }
    var answer = ppoll(heapOffset(block, 16), U64(backings.count), block, nullPointer())
    while failedWith(answer, .Interrupted) {
        answer = ppoll(heapOffset(block, 16), U64(backings.count), block, nullPointer())
    }
    if answerFailed(answer) { return }
    var reported: [Number] = []
    at = 22
    for _ in 0..backings.count {
        reported.append(Number(heapLoad<U16>(block, at)))
        at += 8
    }
    library.readyPolled = copy backings
    library.readyEvents = move reported
}

function kernelReadyForget() {
    library.readyPolled = []
    library.readyEvents = []
}
