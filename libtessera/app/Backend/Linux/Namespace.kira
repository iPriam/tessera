import Foundation
import Heap

// Nodes on Linux (§13.2–13.4). A Node's backing is an `O_PATH` descriptor;
// every lookup goes through `openat2` with `RESOLVE_BENEATH |
// RESOLVE_NO_SYMLINKS | RESOLVE_NO_MAGICLINKS`, so a path never leaves the
// node it is relative to. What a node is comes from `statx`, read here into
// a `KernelNodeStat`; a watch is an inotify instance.

// What the kernel says about a node.
struct KernelNodeStat {
    var kind: NodeKind
    var size: U64
    var allocated: U64
    var blockSize: U32
    var identity: U64
    var volume: U64
    var created: U64
    var modified: U64
    var accessed: U64
    var changed: U64
    var immutable: Bool
    var executable: Bool
    var encrypted: Bool
}

// An entry of a directory: its name, kind and identity.
struct KernelDirectoryEntry {
    var name: String
    var kind: NodeKind
    var identity: U64
}

// The `/proc/self/fd` path for a descriptor: how an `O_PATH` node is
// reopened for what `O_PATH` cannot do.
function descriptorPath(fd: Number) -> String {
    return "/proc/self/fd/" + stringFromUnsigned(U64(fd))
}

// A Node backing for `path` beneath `directory`, opened as itself
// (`O_PATH | O_NOFOLLOW`): a link is never followed. The empty path is the
// directory itself.
function kernelNodeOpen(directory: Number, path: borrow String) -> Result<Number, TesseraError> {
    if path.count == 0 { return kernelDuplicate(directory) }
    let howBytes = zeroedBlock(count: 24, alignment: 16)
    let how = howBytes.pointer()
    heapStore<U64>(how, 0, U64(LinuxOpen.path | openNoFollowFlag() | LinuxOpen.closeOnExec))
    heapStore<U64>(how, 16, Resolve.beneath | Resolve.noSymlinks | Resolve.noMagicLinks)
    let fd = openat2(directory, cStringFrom(path), how, U64(24))
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    return .Ok(fd)
}

function statKind(block: RawPtr) -> NodeKind {
    return match fromCode<FileType>(U32(heapLoad<U16>(block, 28)) & FileMode.typeMask) {
        Regular -> .File
        Directory -> .Directory
        Link -> .Link
        else -> .Special
    }
}

// A `statx_timestamp` as nanoseconds since the epoch.
function statTime(block: RawPtr, offset: Number) -> U64 {
    return heapLoad<U64>(block, offset) * U64(1000000000) + U64(heapLoad<U32>(block, offset + 8))
}

// `statx` with `AT_SYMLINK_NOFOLLOW`, of `name` beneath `directory` or,
// with `AT_EMPTY_PATH` and an empty name, of `directory` itself.
function statAt(directory: Number, name: borrow String) -> Result<KernelNodeStat, TesseraError> {
    let blockBytes = zeroedBlock(count: 256, alignment: 16)
    let block = blockBytes.pointer()
    var flags = AtFlag.symlinkNoFollow
    if name.count == 0 { flags = flags | AtFlag.emptyPath }
    let answer = statx(directory, cStringFrom(name), flags, Statx.basicAndBirth, block)
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    let kind = statKind(block)
    let attributes = heapLoad<U64>(block, 8)
    return .Ok(
        KernelNodeStat {
            kind: kind,
            size: heapLoad<U64>(block, 40),
            allocated: heapLoad<U64>(block, 48) * Statx.blockUnit,
            blockSize: heapLoad<U32>(block, 4),
            identity: heapLoad<U64>(block, 32),
            volume: (U64(heapLoad<U32>(block, 136)) << U64(32)) | U64(heapLoad<U32>(block, 140)),
            created: statTime(block, 80),
            modified: statTime(block, 112),
            accessed: statTime(block, 64),
            changed: statTime(block, 96),
            immutable: (attributes & Statx.immutable) != U64(0),
            executable: kind == .File && (
                U32(heapLoad<U16>(block, 28)) & FileMode.anyExecute
            ) != U32(0),
            encrypted: (attributes & Statx.encrypted) != U64(0),
        }
    )
}

function kernelNodeStat(backing: Number) -> Result<KernelNodeStat, TesseraError> {
    return statAt(backing, "")
}

// `name` beneath `directory`, a link as itself.
function kernelNodeStatAt(
    directory: Number,
    name: borrow String
) -> Result<KernelNodeStat, TesseraError> {
    return statAt(directory, name)
}

function direntKind(entryType: U8) -> NodeKind {
    if entryType == U8(8) { return .File }
    if entryType == U8(4) { return .Directory }
    if entryType == U8(10) { return .Link }
    return .Special
}

// Every entry of the directory but `.` and `..`, from `getdents64`.
function kernelDirectoryList(directory: Number) -> Result<[KernelDirectoryEntry], TesseraError> {
    let readable = openat(
        directory,
        cStringFrom("."),
        LinuxOpen.readOnly | openDirectoryFlag() | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(readable) { return .Error(errnoFailure(answerErrno(readable))) }
    let blockBytes = zeroedBlock(count: 32768, alignment: 16)
    let block = blockBytes.pointer()
    var entries: [KernelDirectoryEntry] = []
    while true {
        let got = getdents64(readable, block, U64(32768))
        if answerFailed(got) || got == 0 { break }
        var at = U64(0)
        while at < U64(got) {
            let length = U64(heapLoad<U16>(block, Number(at + U64(16))))
            let name = stringFromCBytes(
                heapOffset(block, Number(at + U64(19))),
                Number(length - U64(19))
            )
            if name != "." && name != ".." {
                entries.append(
                    KernelDirectoryEntry {
                        name: name,
                        kind: direntKind(heapLoad<U8>(block, Number(at + U64(18)))),
                        identity: heapLoad<U64>(block, at)
                    }
                )
            }
            at += length
        }
    }
    closeBacking(readable)
    return .Ok(entries)
}

// A new directory `name` beneath `directory`, `rwxr-xr-x`.
function kernelMakeDirectory(directory: Number, name: borrow String) -> Result<Void, TesseraError> {
    return answerStatus(mkdirat(directory, cStringFrom(name), FileMode.directoryDefault))
}

// A new empty file `name` beneath `directory`, `rw-r--r--`; `AlreadyExists`
// when the name is taken.
function kernelMakeFile(directory: Number, name: borrow String) -> Result<Void, TesseraError> {
    let made = openat(
        directory,
        cStringFrom(name),
        LinuxOpen.create | LinuxOpen.exclusive | LinuxOpen.readOnly | LinuxOpen.closeOnExec | openNoFollowFlag(),
        FileMode.fileDefault
    )
    if answerFailed(made) { return .Error(errnoFailure(answerErrno(made))) }
    closeBacking(made)
    return .Ok
}

// Removes the non-directory `name`; `IsDirectory` when it is one.
function kernelRemoveFile(directory: Number, name: borrow String) -> Result<Void, TesseraError> {
    return answerStatus(unlinkat(directory, cStringFrom(name), 0))
}

// Removes the empty directory `name`; `NotEmpty` when it is not.
function kernelRemoveDirectory(
    directory: Number,
    name: borrow String
) -> Result<Void, TesseraError> {
    return answerStatus(unlinkat(directory, cStringFrom(name), AtFlag.removeDirectory))
}

// Moves `fromName` to `toName` in one step (`renameat2`): `RENAME_NOREPLACE`
// unless `replace`, or `RENAME_EXCHANGE` to swap the two.
function kernelRename(
    fromDirectory: Number,
    fromName: borrow String,
    toDirectory: Number,
    toName: borrow String,
    replace: Bool,
    exchange: Bool
) -> Result<Void, TesseraError> {
    var flags = RenameFlag.noReplace
    if replace { flags = U32(0) }
    if exchange { flags = RenameFlag.exchange }
    return answerStatus(
        renameat2(fromDirectory, cStringFrom(fromName), toDirectory, cStringFrom(toName), flags)
    )
}

// Sets the node's access and modification times, those asked for
// (`utimensat`, the others `UTIME_OMIT`).
function kernelSetTimes(
    backing: Number,
    setAccessed: Bool,
    accessed: U64,
    setModified: Bool,
    modified: U64
) -> Result<Void, TesseraError> {
    let timesBytes = zeroedBlock(count: 32, alignment: 16)
    let times = timesBytes.pointer()
    heapStore<U64>(times, 8, timeOmit)
    heapStore<U64>(times, 24, timeOmit)
    if setAccessed { storeTimespec(times, U64(0), accessed) }
    if setModified { storeTimespec(times, U64(16), modified) }
    return answerStatus(
        utimensat(AtDirectory.current, cStringFrom(descriptorPath(backing)), times, 0)
    )
}

// Mode 0755 or 0644 through the descriptor's `/proc/self/fd` link, which
// `fchmodat` follows to the file the Node is.
function kernelSetExecutable(backing: Number, on: Bool) -> Result<Void, TesseraError> {
    return answerStatus(
        fchmodat(
            AtDirectory.current,
            cStringFrom(descriptorPath(backing)),
            on ? FileMode.directoryDefault : FileMode.fileDefault,
            0
        )
    )
}

// `FS_IMMUTABLE_FL` (0x10) through `FS_IOC_GETFLAGS` / `FS_IOC_SETFLAGS`.
function kernelSetImmutable(backing: Number, on: Bool) -> Result<Void, TesseraError> {
    let fd = openat(
        AtDirectory.current,
        cStringFrom(descriptorPath(backing)),
        LinuxOpen.readOnly | LinuxOpen.nonBlock | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    let flagsBytes = zeroedBlock(count: 8, alignment: 16)
    let flags = flagsBytes.pointer()
    var answer = ioctl(fd, FileFlags.get, flags)
    if !answerFailed(answer) {
        var value = heapLoad<U32>(flags, 0)
        if on { value = value | FileFlags.immutable } else {
            value = value & complement32(FileFlags.immutable)
        }
        heapStore<U32>(flags, 0, value)
        answer = ioctl(fd, FileFlags.set, flags)
    }
    closeBacking(fd)
    return answerStatus(answer)
}

// The node's path from the root, for display only, without its leading `/`.
function kernelDisplayPath(backing: Number) -> Result<String, TesseraError> {
    let blockBytes = zeroedBlock(count: 4097, alignment: 16)
    let block = blockBytes.pointer()
    let got = readlinkat(
        AtDirectory.current,
        cStringFrom(descriptorPath(backing)),
        block,
        U64(4096)
    )
    if answerFailed(got) { return .Error(errnoFailure(answerErrno(got))) }
    var start = U64(0)
    if got > 1 && heapLoad<U8>(block, 0) == U8(47) { start = U64(1) }
    return .Ok(stringFromCBytes(heapOffset(block, start), Number(U64(got) - start)))
}

// A watch: an inotify instance, nonblocking.
function kernelWatchCreate() -> Result<Number, TesseraError> {
    let fd = inotifyInit1(LinuxOpen.nonBlock | LinuxOpen.closeOnExec)
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    return .Ok(fd)
}

function inotifyMask(mask: WatchMask) -> U32 {
    var bits = U32(0)
    if mask.has(WatchMask.created) { bits = bits | Inotify.create }
    if mask.has(WatchMask.deleted) { bits = bits | Inotify.delete | Inotify.deleteSelf }
    if mask.has(WatchMask.modified) { bits = bits | Inotify.modify | Inotify.closeWrite }
    if mask.has(WatchMask.renamed) {
        bits = bits | Inotify.movedFrom | Inotify.movedTo | Inotify.moveSelf
    }
    if mask.has(WatchMask.attributesChanged) { bits = bits | Inotify.attributes }
    // A recursive watch hears directories made so it can watch them too.
    if mask.has(WatchMask.recursive) { bits = bits | Inotify.create }
    return bits
}

function watchMaskOf(bits: U32) -> U16 {
    var mask = WatchMask.none
    if (bits & Inotify.create) != U32(0) { mask = mask | WatchMask.created }
    if (bits & (Inotify.delete | Inotify.deleteSelf)) != U32(0) { mask = mask | WatchMask.deleted }
    if (bits & (Inotify.modify | Inotify.closeWrite)) != U32(0) { mask = mask | WatchMask.modified }
    if (bits & (Inotify.movedFrom | Inotify.movedTo | Inotify.moveSelf)) != U32(0) {
        mask = mask | WatchMask.renamed
    }
    if (bits & Inotify.attributes) != U32(0) { mask = mask | WatchMask.attributesChanged }
    return U16(mask.raw)
}

// Watches the node for the `WatchMask` changes; the watch's tag for it.
function kernelWatchAdd(
    watch: Number,
    node: Number,
    mask: WatchMask
) -> Result<Number, TesseraError> {
    let tag = inotifyAddWatch(watch, cStringFrom(descriptorPath(node)), inotifyMask(mask))
    if answerFailed(tag) { return .Error(errnoFailure(answerErrno(tag))) }
    return .Ok(tag)
}

// Reads what the watch has into the `capacity` bytes at `target`; the
// bytes read, `ShouldWait` when there are none.
function kernelWatchRead(
    watch: Number,
    target: RawPtr,
    capacity: U64
) -> Result<U64, TesseraError> {
    let got = read(watch, target, capacity)
    if answerFailed(got) { return .Error(channelFailure(answerErrno(got))) }
    return .Ok(U64(got))
}

// One change a watch read: the tag of the node it happened in, the
// `WatchMask` bits (0 for a change the caller did not ask for), the cookie
// pairing the two halves of a rename, the name below the node, whether it
// made a directory, whether the kernel dropped changes, and the bytes it
// took.
struct KernelWatchEvent {
    var tag: Number
    var mask: U16
    var cookie: U32
    var name: String
    var directoryCreated: Bool
    var overrun: Bool
    var bytes: U64
}

// `struct inotify_event` at `at`.
function kernelWatchEventAt(events: RawPtr, at: U64) -> KernelWatchEvent {
    let bits = heapLoad<U32>(events, Number(at + U64(4)))
    let nameLength = U64(heapLoad<U32>(events, Number(at + U64(12))))
    return KernelWatchEvent {
        tag: heapLoad<U32>(events, at),
        mask: watchMaskOf(bits),
        cookie: heapLoad<U32>(events, Number(at + U64(8))),
        name: stringFromCBytes(heapOffset(events, Number(at + U64(16))), nameLength),
        directoryCreated: (bits & (Inotify.isDirectory | Inotify.create)) == (
            Inotify.isDirectory | Inotify.create
        ),
        overrun: (bits & Inotify.overflow) != U32(0),
        bytes: U64(16) + nameLength,
    }
}
