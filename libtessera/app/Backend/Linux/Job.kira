import Foundation
import Heap

// Jobs on Linux are cgroup v2 directories. A job's backing is its
// directory; its watch is `cgroup.events`, which reports `populated 0` once
// the last process has gone. Limits are `pids.max`, `memory.max` and
// `cpu.weight`, and killing is `cgroup.kill`.

// The calling process's own job, from `/proc/self/cgroup`; none on a
// kernel without the cgroup v2 hierarchy.
function kernelJobSelf() -> Result<Number?, TesseraError> {
    let line = try readSmallFile(AtDirectory.current, "/proc/self/cgroup")
    if !line.startsWith("0::") { return .Ok(.None) }
    let path = "/sys/fs/cgroup" + line.substring(3, line.count)
    let fd = openat(
        AtDirectory.current,
        cStringFrom(path),
        LinuxOpen.readOnly | openDirectoryFlag() | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    return .Ok(.Some(fd))
}

// A backing that reports the job's processes coming and going.
function kernelJobWatch(job: Number) -> Result<Number, TesseraError> {
    let events = openat(
        job,
        cStringFrom("cgroup.events"),
        LinuxOpen.readOnly | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(events) { return .Error(errnoFailure(answerErrno(events))) }
    return .Ok(events)
}

// The readiness a job's watch reports when it changes: `cgroup.events`
// raises `POLLPRI`.
let kernelJobWatchReady: Number = Ready.priority

// A new job `name` beneath `parent`, with the controllers its limits need.
function kernelJobCreate(parent: Number, name: borrow String) -> Result<Number, TesseraError> {
    // A controller the kernel does not offer is left out, and the job goes
    // without that limit; one the parent already hands down is not asked for
    // again. A parent that holds processes itself cannot hand any down, and
    // its jobs go without them too.
    let offered = try readSmallFile(parent, "cgroup.controllers")
    let handed = try readSmallFile(parent, "cgroup.subtree_control")
    for controller in ["pids", "memory", "cpu"] {
        if !wordListed(offered, controller) || wordListed(handed, controller) { continue }
        match writeSmallFile(parent, "cgroup.subtree_control", "+" + controller) {
            Ok -> {}
            Error(failed) -> log debug(
                "a job goes without a controller",
                controller,
                error: errorName(failed)
            )
        }
    }
    let made = mkdirat(parent, cStringFrom(name), 0x1ED)
    if answerFailed(made) { return .Error(errnoFailure(answerErrno(made))) }
    let fd = openat(
        parent,
        cStringFrom(name),
        LinuxOpen.readOnly | openDirectoryFlag() | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    return .Ok(fd)
}

// Whether `word` is one of the space-separated words of `list`.
function wordListed(list: borrow String, word: borrow String) -> Bool {
    for listed in list.trim().split(" ") {
        if listed == word { return true }
    }
    return false
}

// Removes the empty job at `path`.
function kernelJobRemovePath(path: borrow String) -> Result<Void, TesseraError> {
    return answerStatus(unlinkat(AtDirectory.current, cStringFrom(path), AtFlag.removeDirectory))
}

// Removes the empty job `name` beneath `parent`.
function kernelJobRemove(parent: Number, name: borrow String) -> Result<Void, TesseraError> {
    return answerStatus(unlinkat(parent, cStringFrom(name), AtFlag.removeDirectory))
}

// Writes the limits the policy sets. Processes and threads are one count to
// the kernel, so `pids.max` is the smaller of the two.
function kernelJobLimits(job: Number, policy: borrow JobPolicy) -> Result<Void, TesseraError> {
    var pids = policy.maxProcesses
    if policy.maxThreads != U32(0) && (pids == U32(0) || policy.maxThreads < pids) {
        pids = policy.maxThreads
    }
    if pids != U32(0) {
        try writeSmallFile(job, "pids.max", stringFromUnsigned(U64(pids)))
    }
    if policy.memoryLimit != U64(0) {
        try writeSmallFile(job, "memory.max", stringFromUnsigned(policy.memoryLimit))
    }
    if policy.cpuShare != U32(0) {
        var weight = policy.cpuShare
        if weight > U32(10000) { weight = U32(10000) }
        try writeSmallFile(job, "cpu.weight", stringFromUnsigned(U64(weight)))
    }
    return .Ok
}

// Kills every process beneath the job.
function kernelJobKill(job: Number) -> Result<Void, TesseraError> {
    return writeSmallFile(job, "cgroup.kill", "1")
}

// Whether any process is in the job, by its watch.
function kernelJobPopulated(watch: Number) -> Result<Bool, TesseraError> {
    let blockBytes = zeroedBlock(count: 257, alignment: 16)
    let block = blockBytes.pointer()
    let got = pread(watch, block, U64(256), U64(0))
    if answerFailed(got) { return .Error(errnoFailure(answerErrno(got))) }
    return .Ok(!stringFromCBytes(block, got).contains("populated 0"))
}

function jobLineCount(job: Number, name: borrow String) -> Result<U32, TesseraError> {
    let text = try readSmallFile(job, name)
    if text.count == 0 { return .Ok(0) }
    return .Ok(U32(text.split("\n").count))
}

// A `key value` line of a cgroup file such as `cpu.stat`; 0 when the file
// has no such line or, for a controller the job was made without, no file.
function cgroupField(
    job: Number,
    file: borrow String,
    key: borrow String
) -> Result<U64, TesseraError> {
    let read = try readSmallFileIfPresent(job, file)
    let text = try read otherwise return .Ok(0)
    let lines = text.split("\n")
    for index in 0..lines.count {
        if lines[index].startsWith(key + " ") {
            return .Ok(parseUnsigned(lines[index].substring(key.count + 1, lines[index].count)))
        }
    }
    return .Ok(0)
}

// What the kernel counts for a job.
struct KernelJobState {
    var populated: Bool
    var processes: U32
    var descendants: U32
    var memory: U64
    var cpu: U64
}

function kernelJobState(job: Number) -> Result<KernelJobState, TesseraError> {
    let populated = try cgroupField(job, "cgroup.events", "populated")
    let processes = try jobLineCount(job, "cgroup.procs")
    let descendants = try cgroupField(job, "cgroup.stat", "nr_descendants")
    // Without the memory controller the job has no count of its own.
    let current = try readSmallFileIfPresent(job, "memory.current")
    let memory = match current {
        Some(text) -> parseUnsigned(text)
        None -> U64(0)
    }
    let usage = try cgroupField(job, "cpu.stat", "usage_usec")
    return .Ok(
        KernelJobState {
            populated: populated != U64(0),
            processes: processes,
            descendants: U32(descendants),
            memory: memory,
            cpu: usage * U64(1000),
        }
    )
}

// The most processes the job may hold, or `0xFFFFFFFF` for no limit, as
// `LimitsInfo` has it.
function kernelJobProcessLimit(job: Number) -> Result<U32, TesseraError> {
    // Without the pids controller there is no limit.
    let read = try readSmallFileIfPresent(job, "pids.max")
    let limit = match read {
        Some(text) -> text.trim()
        None -> "max"
    }
    if limit == "max" { return .Ok(0xFFFFFFFF) }
    return .Ok(U32(parseUnsigned(limit)))
}
