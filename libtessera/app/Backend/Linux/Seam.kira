import Foundation
import Heap

// The backend seam on Linux (17 §6.3, §20.4): DeviceKit's backend and its
// manager drive devices with the kernel's own calls, and this is where they
// are made. Each takes and answers the kernel's own numbers: descriptors,
// `open` and `ioctl` numbers, `struct msghdr` and `struct pollfd` as the
// kernel lays them out. A failure keeps its `errno` in `detail`.

function seamAnswer(answer: Number) -> Result<U64, TesseraError> {
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    return .Ok(U64(answer))
}

// `AT_FDCWD`: every path the seam is given is absolute.
function kernelSeamOpen(path: borrow String, flags: U64, mode: U64) -> Result<U64, TesseraError> {
    return seamAnswer(openat(AtDirectory.current, cStringFrom(path), flags, mode))
}

function kernelSeamClose(object: U64) -> Result<Void, TesseraError> {
    return answerStatus(close(object))
}

function kernelSeamRead(object: U64, address: RawPtr, length: U64) -> Result<U64, TesseraError> {
    return seamAnswer(read(object, address, length))
}

function kernelSeamWrite(object: U64, address: RawPtr, length: U64) -> Result<U64, TesseraError> {
    return seamAnswer(write(object, address, length))
}

function kernelSeamReadAt(
    object: U64,
    address: RawPtr,
    length: U64,
    offset: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(pread(object, address, length, offset))
}

function kernelSeamWriteAt(
    object: U64,
    address: RawPtr,
    length: U64,
    offset: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(pwrite(object, address, length, offset))
}

// `ioctl`.
function kernelSeamControl(
    object: U64,
    request: U64,
    argument: RawPtr
) -> Result<U64, TesseraError> {
    return seamAnswer(ioctl(object, request, argument))
}

// `fcntl`.
function kernelSeamObjectControl(
    object: U64,
    command: U64,
    argument: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(fcntl(object, command, pointerAt(argument)))
}

// `getdents64`.
function kernelSeamDirectoryRead(
    object: U64,
    address: RawPtr,
    length: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(getdents64(object, address, length))
}

function kernelSeamReadLink(
    path: borrow String,
    address: RawPtr,
    length: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(readlinkat(AtDirectory.current, cStringFrom(path), address, length))
}

function kernelSeamMap(
    address: RawPtr,
    length: U64,
    protection: U64,
    flags: U64,
    object: U64,
    offset: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(mmap(address, length, protection, flags, object, offset))
}

function kernelSeamUnmap(address: RawPtr, length: U64) -> Result<Void, TesseraError> {
    return answerStatus(munmap(address, length))
}

// `lseek`.
function kernelSeamSeek(object: U64, offset: U64, whence: U64) -> Result<U64, TesseraError> {
    return seamAnswer(lseek(object, offset, whence))
}

function kernelSeamSyncData(object: U64) -> Result<Void, TesseraError> {
    return answerStatus(fdatasync(object))
}

// `ppoll` over `count` `struct pollfd` records, with a `struct timespec`
// (or none) as the timeout.
function kernelSeamPoll(records: RawPtr, count: U64, timeout: RawPtr) -> Result<U64, TesseraError> {
    return seamAnswer(ppoll(records, count, timeout, nullPointer()))
}

// `eventfd2`.
function kernelSeamEventObject(initial: U64, flags: U64) -> Result<U64, TesseraError> {
    return seamAnswer(eventfd2(U32(initial), flags))
}

// `memfd_create`.
function kernelSeamMemoryObject(name: borrow String, flags: U64) -> Result<U64, TesseraError> {
    return seamAnswer(memfdCreate(cStringFrom(name), U32(flags)))
}

// `timerfd_create` and `timerfd_settime`.
function kernelSeamTimerObject(clock: U64, flags: U64) -> Result<U64, TesseraError> {
    return seamAnswer(timerfdCreate(clock, flags))
}

function kernelSeamTimerSet(
    object: U64,
    flags: U64,
    value: RawPtr,
    old: RawPtr
) -> Result<Void, TesseraError> {
    return answerStatus(timerfdSettime(object, flags, value, old))
}

function kernelSeamSocket(family: U64, kind: U64, protocol: U64) -> Result<U64, TesseraError> {
    return seamAnswer(socket(family, kind, protocol))
}

function kernelSeamBind(object: U64, address: RawPtr, length: U64) -> Result<Void, TesseraError> {
    return answerStatus(bind(object, address, U32(length)))
}

function kernelSeamListen(object: U64, backlog: U64) -> Result<Void, TesseraError> {
    return answerStatus(listen(object, backlog))
}

// `accept4`, without the peer's address.
function kernelSeamAccept(object: U64, flags: U64) -> Result<U64, TesseraError> {
    return seamAnswer(accept4(object, nullPointer(), nullPointer(), flags))
}

function kernelSeamConnect(
    object: U64,
    address: RawPtr,
    length: U64
) -> Result<Void, TesseraError> {
    return answerStatus(connect(object, address, U32(length)))
}

// `sendmsg` and `recvmsg` on a `struct msghdr`.
function kernelSeamSendMessage(
    object: U64,
    message: RawPtr,
    flags: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(sendmsg(object, message, flags))
}

function kernelSeamReceiveMessage(
    object: U64,
    message: RawPtr,
    flags: U64
) -> Result<U64, TesseraError> {
    return seamAnswer(recvmsg(object, message, flags))
}

// `getsockopt`.
function kernelSeamGetOption(
    object: U64,
    level: U64,
    name: U64,
    value: RawPtr,
    length: RawPtr
) -> Result<Void, TesseraError> {
    return answerStatus(getsockopt(object, level, name, value, length))
}
