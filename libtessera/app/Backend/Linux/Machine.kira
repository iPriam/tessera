import Foundation
import Heap

// The machine, its volumes and its first process, on Linux (§25.5).
//
// Linux wants its own file systems mounted before anything reads `/proc` or
// makes a job, answers a stop with `reboot`, and tells PID 1 what happened to
// the machine with signals. All of that is here, so init says what it wants
// and never how this kernel spells it.

namespace MountFlag {
    let readOnly: U64 = U64(1)
    let noSetIdentity: U64 = U64(2)
    let noDevices: U64 = U64(4)
    let noExecute: U64 = U64(8)
    let bind: U64 = U64(4096)
    let move: U64 = U64(8192)
    // `umount2`'s `MNT_DETACH`.
    let detach: Number = 2
}

namespace Reboot {
    let magic: Number = 0xfee1dead
    let magicSecond: Number = 672274793
    let powerOff: Number = 0x4321FEDC
    let restart: Number = 0x01234567
    // `LINUX_REBOOT_CMD_CAD_OFF`: Ctrl-Alt-Del becomes `SIGINT` to PID 1.
    let controlAltDeleteOff: Number = 0
}

// The `mount` flags for `options`.
function mountFlags(options: VolumeOptions) -> U64 {
    var flags = U64(0)
    if options.has(VolumeOptions.readOnly) { flags = flags | MountFlag.readOnly }
    if options.has(VolumeOptions.noExecute) { flags = flags | MountFlag.noExecute }
    if options.has(VolumeOptions.noDevices) { flags = flags | MountFlag.noDevices }
    if options.has(VolumeOptions.noSetIdentity) { flags = flags | MountFlag.noSetIdentity }
    if options.has(VolumeOptions.bind) { flags = flags | MountFlag.bind }
    if options.has(VolumeOptions.move) { flags = flags | MountFlag.move }
    return flags
}

// The kernel's name for `format`; none for `None`.
function formatName(format: borrow VolumeFormat) -> String? {
    match format {
        None -> return .None
        Ext4 -> return .Some("ext4")
        Btrfs -> return .Some("btrfs")
        Fat -> return .Some("vfat")
        Erofs -> return .Some("erofs")
        Squashfs -> return .Some("squashfs")
    }
}

// A disk's node: a bare name from `kernelDiskNames` lives in `/dev`.
function diskNode(source: borrow String) -> String {
    if source.count == 0 || source.startsWith("/") { return copy source }
    return "/dev/" + source
}

function mountOne(
    source: borrow String,
    target: borrow String,
    kind: borrow String,
    flags: U64
) -> Result<Void, TesseraError> {
    return answerStatus(
        mount(cStringFrom(source), cStringFrom(target), cStringFrom(kind), flags, nullPointer())
    )
}

function kernelVolumeMount(
    source: borrow String,
    target: borrow String,
    format: borrow VolumeFormat,
    options: VolumeOptions
) -> Result<Void, TesseraError> {
    let flags = mountFlags(options)
    if options.has(VolumeOptions.bind) || options.has(VolumeOptions.move) {
        return mountOne(source, target, "", flags)
    }
    match formatName(format) {
        Some(kind) -> return mountOne(diskNode(source), target, kind, flags)
        None -> return .Error(failure(.Unsupported))
    }
}

function kernelVolumeUnmount(
    target: borrow String,
    options: VolumeUnmountOptions
) -> Result<Void, TesseraError> {
    let flags = options.has(VolumeUnmountOptions.detach) ? MountFlag.detach : 0
    return answerStatus(umount2(cStringFrom(target), flags))
}

// The entries of the directory at `path`.
function listPath(path: borrow String) -> Result<[KernelDirectoryEntry], TesseraError> {
    let directory = openat(
        AtDirectory.current,
        cStringFrom(path),
        LinuxOpen.readOnly | openDirectoryFlag() | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(directory) { return .Error(errnoFailure(answerErrno(directory))) }
    let listed = kernelDirectoryList(directory)
    kernelRelease(directory)
    return listed
}

// Whether the disk `a` was numbered before `b`. The kernel names a kind's
// disks `vda` to `vdz`, then `vdaa`, so a shorter name comes first and names
// of one length go in byte order.
function diskBefore(a: borrow String, b: borrow String) -> Bool {
    if a.count != b.count { return a.count < b.count }
    for index in 0..a.count {
        let left = heapLoad<U8>(a.data, index)
        let right = heapLoad<U8>(b.data, index)
        if left != right { return left < right }
    }
    return false
}

// The machine's disks, in the order the kernel numbered them: every entry of
// `/sys/block` but the ones that are not disks (loop, ram, zram and optical
// devices). The directory lists them in no particular order.
function kernelDiskNames() -> Result<[String], TesseraError> {
    var names: [String] = []
    let listed = try listPath("/sys/block")
    for index in 0..listed.count {
        let name = listed[index].name
        if name != "." && name != ".." && !name.startsWith("loop") && !name.startsWith("ram")
            && !name.startsWith("zram") && !name.startsWith("sr") {
            var at = names.count
            names.append(copy name)
            while at > 0 && diskBefore(names[at], names[at - 1]) {
                let earlier = copy names[at - 1]
                names[at - 1] = copy names[at]
                names[at] = earlier
                at -= 1
            }
        }
    }
    return .Ok(names)
}

// `/proc/self/mounts`: one `source target` pair per line.
function kernelMountTable() -> Result<String, TesseraError> {
    let mounts = try readSmallFile(AtDirectory.current, "/proc/self/mounts")
    let lines = mounts.split("\n")
    var table = ""
    for index in 0..lines.count {
        let fields = lines[index].split(" ")
        if fields.count >= 2 { table = table + fields[0] + " " + fields[1] + "\n" }
    }
    return .Ok(table)
}

// Whether a volume is mounted at `target`, and read-only: the options of its
// line in the mount table begin with `ro`. The last line for the target is
// the mount on top.
function kernelVolumeReadOnlyAt(target: borrow String) -> Result<Bool, TesseraError> {
    let mounts = try readSmallFile(AtDirectory.current, "/proc/self/mounts")
    var readOnly = false
    for line in mounts.split("\n") {
        let fields = line.split(" ")
        if fields.count >= 4 && fields[1] == target {
            readOnly = fields[3] == "ro" || fields[3].startsWith("ro,")
        }
    }
    return .Ok(readOnly)
}

// Whether the volume holding `path` is read-only: the options of the line
// whose mount point is the longest one `path` lies in begin with `ro`. Of
// several lines for one mount point, the last is the mount on top.
function kernelPathReadOnly(path: borrow String) -> Result<Bool, TesseraError> {
    let mounts = try readSmallFile(AtDirectory.current, "/proc/self/mounts")
    var holder = ""
    var readOnly = false
    for line in mounts.split("\n") {
        let fields = line.split(" ")
        if fields.count < 4 { continue }
        let mountPoint = fields[1]
        if !pathWithin(path, mountPoint) || mountPoint.count < holder.count { continue }
        holder = copy mountPoint
        readOnly = fields[3] == "ro" || fields[3].startsWith("ro,")
    }
    return .Ok(readOnly)
}

// Whether `path` is `directory` or lies beneath it.
function pathWithin(path: borrow String, directory: borrow String) -> Bool {
    if directory == "/" { return path.startsWith("/") }
    return path == directory || path.startsWith(directory + "/")
}

// `struct statfs` as aarch64 and x86-64 lay it out: eleven longs, then four
// spare ones.
@FFI.Struct { layout: c }
struct KernelStatfs {
    var kind: Int = 0
    var blockSize: Int = 0
    var blocks: Int = 0
    var freeBlocks: Int = 0
    var availableBlocks: Int = 0
    var files: Int = 0
    var freeFiles: Int = 0
    var fileSystemId: Int = 0
    var nameLength: Int = 0
    var fragmentSize: Int = 0
    var flags: Int = 0
    var spare0: Int = 0
    var spare1: Int = 0
    var spare2: Int = 0
    var spare3: Int = 0
}

// The size of the volume holding `target` and the bytes on it a program may
// still write, in that order.
function kernelVolumeSpace(target: borrow String) -> Result<(Number, Number), TesseraError> {
    let block = zeroedBlock(count: sizeOf<KernelStatfs>(), alignment: 16)
    let answer = statfs(cStringFrom(target), block.pointer())
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    let status = heapLoad<KernelStatfs>(block.pointer())
    let unit = Number(status.fragmentSize > 0 ? status.fragmentSize : status.blockSize)
    return .Ok((Number(status.blocks) * unit, Number(status.availableBlocks) * unit))
}

// What Linux needs mounted before a userland can run on it: the process and
// device file systems, the cgroup v2 hierarchy jobs are made in, and a
// memory-backed `/tmp` and `/run`, which hold nothing that outlives a boot,
// and the kernel tracer, which `traceBegin` and its kin write to.
// One that will not mount is left out and the others are still tried; the
// answer is the first failure.
function kernelMachinePrepare() -> Result<Void, TesseraError> {
    let kinds = ["proc", "sysfs", "cgroup2", "tracefs", "devtmpfs", "tmpfs", "tmpfs"]
    let targets = ["/proc", "/sys", "/sys/fs/cgroup", "/sys/kernel/tracing", "/dev", "/tmp", "/run"]
    var firstFailure: TesseraError? = .None
    for index in 0..kinds.count {
        match mountOne(kinds[index], targets[index], kinds[index], U64(0)) {
            Ok -> {}
            Error(failed) -> {
                // Detail 16 is EBUSY: the file system is mounted there already.
                if failed.detail != U64(16) && firstFailure.isNone() {
                    firstFailure = .Some(failed)
                }
            }
        }
    }
    match mountVolumesDirectory() {
        Ok -> {}
        Error(failed) -> {
            if firstFailure.isNone() { firstFailure = .Some(failed) }
        }
    }
    match kernelChannelLimits() {
        Ok -> {}
        Error(failed) -> {
            if firstFailure.isNone() { firstFailure = .Some(failed) }
        }
    }
    match firstFailure {
        Some(failed) -> return .Error(failed)
        None -> return .Ok
    }
}

// An empty in-memory `/Volumes`, when the root has that directory: it holds
// only the mount points the Volume service makes, which live as long as the
// machine runs, and a sealed root cannot hold them. Detail 2 is ENOENT, a root
// without the directory, and 16 EBUSY, one mounted there already.
function mountVolumesDirectory() -> Result<Void, TesseraError> {
    let options = VolumeOptions.noExecute | VolumeOptions.noDevices | VolumeOptions.noSetIdentity
    let data = cStringFrom("mode=0755")
    let answer = mount(
        cStringFrom("tmpfs"),
        cStringFrom("/" + SystemDirectory.volumes),
        cStringFrom("tmpfs"),
        mountFlags(options),
        data.address
    )
    match answerStatus(answer) {
        Ok -> return .Ok
        Error(failed) -> {
            if failed.detail == U64(2) || failed.detail == U64(16) { return .Ok }
            return .Error(failed)
        }
    }
}

// A channel's queue as §10.1 bounds it, 4 MiB or 1 024 messages a direction,
// for every socket made from here on. Linux queues ten datagrams on a unix
// socket unless told otherwise, and caps a socket's send buffer far below
// what `channelQueueBytes` asks for.
function kernelChannelLimits() -> Result<Void, TesseraError> {
    try writeSmallFile(AtDirectory.current, "/proc/sys/net/unix/max_dgram_qlen", "1024\n")
    return writeSmallFile(AtDirectory.current, "/proc/sys/net/core/wmem_max", "4194304\n")
}

// Only critical kernel messages reach the console once userland runs:
// `console_loglevel` 3 prints levels 0 to 2. The rest stay in the ring
// buffer.
function kernelQuietConsole() -> Result<Void, TesseraError> {
    return writeSmallFile(AtDirectory.current, "/proc/sys/kernel/printk", "3\n")
}

// `core_pattern` piped to `program`; `core_pipe_limit` is how many dying
// processes the kernel holds for it at once, each until it exits.
//
// The core holds only private anonymous memory, where the threads' stacks
// are, and PID 1's filter passes to everything it starts. A shared mapping --
// the memfd a display client draws into, a gigabyte of GPU memory -- went
// into the pipe ahead of the stacks at the top of the address space, and the
// dying process was held, its screen frozen and never started again, while
// the reporter read through it.
function kernelCrashReporter(program: borrow String) -> Result<Void, TesseraError> {
    try writeSmallFile(AtDirectory.current, "/proc/self/coredump_filter", "0x1\n")
    try writeSmallFile(AtDirectory.current, "/proc/sys/kernel/core_pipe_limit", "8\n")
    return writeSmallFile(AtDirectory.current, "/proc/sys/kernel/core_pattern", "|\(program) %P\n")
}

function kernelMachineFlush() -> Result<Void, TesseraError> { return answerStatus(sync()) }

// `LINUX_REBOOT_CMD_POWER_OFF` or `_RESTART`, after a sync. Returns only
// when the kernel refuses.
function kernelMachineStop(how: borrow MachineStop) -> Result<Void, TesseraError> {
    // A volume that cannot be flushed is still better stopped than kept up
    // by a machine nobody wants running.
    match answerStatus(sync()) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
    let command = match how {
        PowerOff -> Reboot.powerOff
        Restart -> Reboot.restart
    }
    return answerStatus(reboot(Reboot.magic, Reboot.magicSecond, command, nullPointer()))
}

// Moves the volume mounted at `path` onto `/` and makes it this process's
// root: `pivot_root` cannot leave an initramfs, so it is a move and a chroot.
function kernelEnterRoot(path: borrow String) -> Result<Void, TesseraError> {
    try answerStatus(chdir(cStringFrom(path)))
    try mountOne(".", "/", "", MountFlag.move)
    try answerStatus(chroot(cStringFrom(".")))
    return answerStatus(chdir(cStringFrom("/")))
}

// The environment a child is started with: the Kira runtime's own settings
// the parent was given, and the output's scale the boot names, and nothing else.
function runtimeEnvironment() -> ByteBlock {
    var strings: [String] = []
    for name in ["KLF_HEAP_REPORT", "KIRA_LOG", "TESSERA_OUTPUT_SCALE"] {
        if environmentIsSet(name) { strings.append(name + "=" + environmentValue(name)) }
    }
    return argumentVector(strings)
}

// Replaces this process with the program at `path`, started with
// `arguments`. Returns only on failure.
function kernelProcessReplace(
    path: borrow String,
    arguments: borrow [String]
) -> Result<Void, TesseraError> {
    let argvBytes = argumentVector(arguments)
    let envpBytes = runtimeEnvironment()
    return answerStatus(execve(cStringFrom(path), argvBytes.pointer(), envpBytes.pointer()))
}

// ─── What happens to the first process ──────────────────────────────────────

// A backing readable when the machine is asked to stop (`SIGTERM`), when
// someone asks for its attention (`SIGINT`, which Ctrl-Alt-Del becomes once
// `LINUX_REBOOT_CMD_CAD_OFF` is set), or when a child ends (`SIGCHLD`). The
// three are blocked and read through one `signalfd`.
function kernelSystemWatch() -> Result<Number, TesseraError> {
    match library.systemWatch {
        Some(watch) -> return .Ok(watch)
        None -> {}
    }
    let maskBytes = zeroedBlock(count: 8, alignment: 8)
    let mask = maskBytes.pointer()
    heapStore<U64>(mask, 0, (U64(1) << U64(14)) | (U64(1) << U64(1)) | (U64(1) << U64(16)))
    let blocked = sigprocmask(SignalMaskHow.block, mask, nullPointer(), U64(8))
    if answerFailed(blocked) { return .Error(errnoFailure(answerErrno(blocked))) }
    let fd = signalfd4(-1, mask, U64(8), LinuxOpen.nonBlock | LinuxOpen.closeOnExec)
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    // Refused, Ctrl-Alt-Del restarts the machine at once rather than asking
    // PID 1; the watch still hears the rest.
    match answerStatus(
        reboot(Reboot.magic, Reboot.magicSecond, Reboot.controlAltDeleteOff, nullPointer())
    ) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
    library.systemWatch = .Some(fd)
    return .Ok(fd)
}

// The signals the system watch reads, as `signalfd` numbers them.
@Derive(Copy)
@Open enum WatchedSignal: U32 {
    Interrupt = 2
    Terminate = 15
    Child = 17
}

// Everything the watch holds.
function kernelSystemEvents() -> SystemEvent {
    let watch = try library.systemWatch otherwise return SystemEvent.none
    let infoBytes = zeroedBlock(count: 128, alignment: 16)
    let info = infoBytes.pointer()
    var events = SystemEvent.none
    while true {
        let got = read(watch, info, U64(128))
        if answerFailed(got) || got < 128 { break }
        match fromCode<WatchedSignal>(heapLoad<U32>(info, 0)) {
            Terminate -> events = events | SystemEvent.stop
            Interrupt -> events = events | SystemEvent.attention
            Child -> events = events | SystemEvent.childEnded
            // Nothing else is blocked, so nothing else is read.
            else -> {}
        }
    }
    return events
}

// Reaps every ended child that is not in `own`: the processes reparented
// to PID 1, which nobody holds a backing for. A child of the caller's own
// is left for its Process object. Answers how many were reaped.
function kernelReapOrphans(own: borrow [U64]) -> Result<U32, TesseraError> {
    let parent = stringFromUnsigned(U64(getpid()))
    let listed = try listPath("/proc")
    let infoBytes = zeroedBlock(count: 128, alignment: 16)
    let info = infoBytes.pointer()
    var reaped = U32(0)
    for index in 0..listed.count {
        let pid = parseUnsigned(listed[index].name)
        var mine = pid == U64(0)
        for at in 0..own.count {
            if own[at] == pid { mine = true }
        }
        if !mine {
            // One that has gone since the listing needs no reaping.
            let read = try processStatFields(pid)
            let fields = match read {
                Some(value) -> value
                None -> []
            }
            if fields.count > 1 && fields[0] == "Z" && fields[1] == parent {
                if !answerFailed(
                    waitid(
                        code(WaitWhom.Pid),
                        pid,
                        info,
                        (WaitHow.exited | WaitHow.noHang).raw,
                        nullPointer()
                    )
                ) {
                    reaped += U32(1)
                }
            }
        }
    }
    return .Ok(reaped)
}

// Sets the wall clock (`CLOCK_REALTIME`) to `nanoseconds` since 1970.
function kernelSetRealtime(nanoseconds: U64) -> Result<Void, TesseraError> {
    let valueBytes = zeroedBlock(count: 16, alignment: 16)
    let value = valueBytes.pointer()
    storeTimespec(value, U64(0), nanoseconds)
    return answerStatus(clockSettime(0, value))
}

// The process's standard stream `stream`, as a backing of its own
// (`F_DUPFD_CLOEXEC` above the streams), or None when it is not open.
function kernelStandardStream(stream: borrow StandardStream) -> Result<Number?, TesseraError> {
    let copied = fcntl(Number(code(stream)), Fcntl.duplicateCloseOnExec, RawPtr(Fcntl.aboveStreams))
    if answerFailed(copied) {
        // A stream the process was started without.
        if answerErrno(copied) == code(Errno.BadDescriptor) { return .Ok(.None) }
        return .Error(errnoFailure(answerErrno(copied)))
    }
    return .Ok(.Some(copied))
}
