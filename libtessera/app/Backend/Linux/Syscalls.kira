@FFI.Syscall { name: perf_event_open }
function perfEventOpen(attributes: RawPtr, pid: U32, cpu: U32, group: U32, flags: U64) -> Int

// `ioctl` for a request whose argument is a number rather than a pointer.
@FFI.Syscall { name: ioctl }
function ioctlValue(fd: Int, request: U64, argument: Int) -> Int

