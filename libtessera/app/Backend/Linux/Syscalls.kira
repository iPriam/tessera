import Foundation

// The Linux backend's calls into the kernel (§21.1).
//
// Every one is resolved by name through the framework's syscall table, which
// carries both architectures. Calls that exist on only one of them (`open`,
// `poll`, `arch_prctl`, `epoll_wait`) are not used, so the same source is the
// same program on aarch64 and x86-64.

@FFI.Syscall { name: read }
function read(fd: Int, buffer: RawPtr, count: U64) -> Int

@FFI.Syscall { name: write }
function write(fd: Int, buffer: RawPtr, count: U64) -> Int

@FFI.Syscall { name: pread64 }
function pread(fd: Int, buffer: RawPtr, count: U64, offset: U64) -> Int

@FFI.Syscall { name: pwrite64 }
function pwrite(fd: Int, buffer: RawPtr, count: U64, offset: U64) -> Int

@FFI.Syscall { name: preadv }
function preadv(fd: Int, vectors: RawPtr, count: Int, offsetLow: U64, offsetHigh: U64) -> Int

@FFI.Syscall { name: pwritev }
function pwritev(fd: Int, vectors: RawPtr, count: Int, offsetLow: U64, offsetHigh: U64) -> Int

@FFI.Syscall { name: writev }
function writev(fd: Int, vectors: RawPtr, count: Int) -> Int

@FFI.Syscall { name: close }
function close(fd: Int) -> Int

@FFI.Syscall { name: close_range }
function closeRange(first: U32, last: U32, flags: U32) -> Int

@FFI.Syscall { name: dup3 }
function dup3(fd: Int, target: Int, flags: Int) -> Int

@FFI.Syscall { name: fcntl }
