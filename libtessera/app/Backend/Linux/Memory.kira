import Foundation
import Heap

// Memory on Linux (§6.2, §6.3): a Memory object's backing is a memfd, and
// the address space is `mmap` and its relatives. Above this file a backing
// is an opaque number and a range is a base and a length.

// The auxiliary vector's entry `wanted`, when the kernel gave one.
function auxiliaryValue(wanted: Auxiliary) -> Result<U64?, TesseraError> {
    let fd = openat(
        AtDirectory.current,
        cStringFrom("/proc/self/auxv"),
        LinuxOpen.readOnly | LinuxOpen.closeOnExec,
        0
    )
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    let blockBytes = zeroedBlock(count: 16, alignment: 16)
    let block = blockBytes.pointer()
    var value: U64? = .None
    while true {
        let got = read(fd, block, U64(16))
        if answerFailed(got) {
            closeBacking(fd)
            return .Error(errnoFailure(answerErrno(got)))
        }
        // The vector ends with `AT_NULL`.
        if got < 16 || heapLoad<U64>(block, 0) == U64(0) { break }
        if heapLoad<U64>(block, 0) == code(wanted) {
            value = .Some(heapLoad<U64>(block, 8))
            break
        }
    }
    closeBacking(fd)
    return .Ok(value)
}

// The page size, from `AT_PAGESZ` in the auxiliary vector.
function kernelPageSize() -> U64 {
    if library.pageSize != U64(0) { return library.pageSize }
    // The first process runs before `/proc` is mounted; both architectures'
    // smallest page is the safe bootstrap fallback.
    let found = try auxiliaryValue(.PageSize) otherwise .None
    library.pageSize = found.or(U64(4096))
    return library.pageSize
}

// Gives a backing back to the kernel.
function kernelRelease(backing: Number) {
    closeBacking(backing)
}

// A memfd of `size` zero bytes. One that cannot be resized is sealed
// against growing and shrinking (`F_ADD_SEALS`, 1033: `F_SEAL_SHRINK |
// F_SEAL_GROW`).
function kernelMemoryCreate(size: U64, resizable: Bool) -> Result<Number, TesseraError> {
    let fd = memfdCreate(cStringFrom("tessera-memory"), U32(1 | 2))
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    let sized = ftruncate(fd, size)
    if answerFailed(sized) {
        closeBacking(fd)
        return .Error(errnoFailure(answerErrno(sized)))
    }
    if !resizable {
        let sealed = fcntl(fd, Fcntl.addSeals, RawPtr(Seal.shrink | Seal.grow))
        if answerFailed(sealed) {
            closeBacking(fd)
            return .Error(errnoFailure(answerErrno(sealed)))
        }
    }
    return .Ok(fd)
}

function kernelMemoryResize(backing: Number, size: U64) -> Result<Void, TesseraError> {
    return answerStatus(ftruncate(backing, size))
}

// A second backing for the same kernel object (`F_DUPFD_CLOEXEC`, 1030),
// numbered above the standard streams.
function kernelDuplicate(backing: Number) -> Result<Number, TesseraError> {
    let fd = fcntl(backing, Fcntl.duplicateCloseOnExec, RawPtr(Fcntl.aboveStreams))
    if answerFailed(fd) { return .Error(errnoFailure(answerErrno(fd))) }
    return .Ok(fd)
}

// Copies `length` bytes between two backings through a bounce block.
function kernelCopyRange(
    from: Number,
    fromOffset: U64,
    to: Number,
    toOffset: U64,
    length: U64
) -> Result<Void, TesseraError> {
    let chunk = U64(65536)
    let blockBytes = zeroedBlock(count: chunk, alignment: 16)
    let block = blockBytes.pointer()
    var done = U64(0)
    while done < length {
        var step = length - done
        if step > chunk { step = chunk }
        let got = pread(from, block, step, fromOffset + done)
        if answerFailed(got) || got == 0 {
            if answerFailed(got) { return .Error(errnoFailure(answerErrno(got))) }
            return .Error(failure(.OutOfRange))
        }
        try kernelWriteAt(to, block, U64(got), toOffset + done)
        done += U64(got)
    }
    return .Ok
}

// `length` bytes written at `offset`, all of them or an error.
function kernelWriteAt(
    backing: Number,
    source: RawPtr,
    length: U64,
    offset: U64
) -> Result<Void, TesseraError> {
    var done = U64(0)
    while done < length {
        let wrote = pwrite(backing, heapOffset(source, done), length - done, offset + done)
        if answerFailed(wrote) { return .Error(errnoFailure(answerErrno(wrote))) }
        if wrote == 0 { return .Error(failure(.NoSpace)) }
        done += U64(wrote)
    }
    return .Ok
}

// `length` bytes read from `offset`, all of them or an error.
function kernelReadAt(
    backing: Number,
    target: RawPtr,
    length: U64,
    offset: U64
) -> Result<Void, TesseraError> {
    var done = U64(0)
    while done < length {
        let got = pread(backing, heapOffset(target, done), length - done, offset + done)
        if answerFailed(got) { return .Error(errnoFailure(answerErrno(got))) }
        if got == 0 { return .Error(failure(.OutOfRange)) }
        done += U64(got)
    }
    return .Ok
}

// Bytes backed by storage: `stx_blocks` (offset 48) in 512-byte units.
function kernelAllocatedBytes(backing: Number) -> Result<U64, TesseraError> {
    let blockBytes = zeroedBlock(count: 256, alignment: 16)
    let block = blockBytes.pointer()
    let answer = statx(backing, cStringFrom(""), AtFlag.emptyPath, Statx.blocks, block)
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    return .Ok(heapLoad<U64>(block, 48) * Statx.blockUnit)
}

// Where a new range goes: near the hint, wherever there is room; exactly at
// the address, which must be free; or exactly at the address, replacing what
// this process reserved there.
@Derive(Copy)
enum Place {
    Anywhere
    Free
    Over
}

namespace MapFlag {
    let shared: Number = 0x1
    let private: Number = 0x2
    let fixed: Number = 0x10
    let anonymous: Number = 0x20
    let noReserve: Number = 0x4000
    let fixedNoReplace: Number = 0x100000
}

// `madvise` advice.
namespace Advice {
    let dontNeed: Number = 4
    let hugePage: Number = 14
    let populateRead: Number = 22
    let populateWrite: Number = 23
}

namespace ProtectionFlag {
    let none: Number = 0
    let read: Number = 1
    let write: Number = 2
    let execute: Number = 4
}

// `MAP_FIXED_NOREPLACE` or `MAP_FIXED`.
function placementFlags(placement: borrow Place) -> Number {
    return match placement {
        Anywhere -> 0
        Free -> MapFlag.fixedNoReplace
        Over -> MapFlag.fixed
    }
}

// `PROT_*` from `Protection`.
function protectionFlags(protection: Protection) -> Number {
    var bits = ProtectionFlag.none
    if protection.has(Protection.read) { bits = bits | ProtectionFlag.read }
    if protection.has(Protection.write) { bits = bits | ProtectionFlag.write }
    if protection.has(Protection.execute) { bits = bits | ProtectionFlag.execute }
    return bits
}

function mapAnswer(answer: Number) -> Result<U64, TesseraError> {
    if answerFailed(answer) {
        if failedWith(answer, .Exists) { return .Error(failure(.AlreadyExists)) }
        return .Error(errnoFailure(answerErrno(answer)))
    }
    return .Ok(U64(answer))
}

// An inaccessible range that takes no memory: `MAP_PRIVATE |
// MAP_ANONYMOUS | MAP_NORESERVE`.
function kernelReserve(at: U64, length: U64, placement: borrow Place) -> Result<U64, TesseraError> {
    return mapAnswer(
        mmap(
            RawPtr(at),
            length,
            ProtectionFlag.none,
            MapFlag.private | MapFlag.anonymous | MapFlag.noReserve | placementFlags(placement),
            -1,
            U64(0)
        )
    )
}

// The backing's bytes from `offset` mapped at `at`, shared with every other
// mapping of it or private to this one.
function kernelMapBacking(
    at: U64,
    length: U64,
    protection: Protection,
    shared: Bool,
    placement: borrow Place,
    backing: Number,
    offset: U64
) -> Result<U64, TesseraError> {
    let sharing = shared ? MapFlag.shared : MapFlag.private
    return mapAnswer(
        mmap(
            RawPtr(at),
            length,
            protectionFlags(protection),
            sharing | placementFlags(placement),
            backing,
            offset
        )
    )
}

function kernelUnmap(at: U64, length: U64) -> Result<Void, TesseraError> {
    return answerStatus(munmap(RawPtr(at), length))
}

function kernelProtect(at: U64, length: U64, protection: Protection) -> Result<Void, TesseraError> {
    return answerStatus(mprotect(RawPtr(at), length, protectionFlags(protection)))
}

// A hint that the range be backed by huge pages (`MADV_HUGEPAGE`, 14). A
// kernel without them maps the range with small pages, which is all a hint
// can come to.
function kernelPreferHugePages(at: U64, length: U64) {
    match answerStatus(madvise(RawPtr(at), length, Advice.hugePage)) {
        Ok -> {}
        Error(failed) -> absorb failed
    }
}

// Backs the range with pages now: `MADV_POPULATE_WRITE` (23), or
// `MADV_POPULATE_READ` (22) on a range that cannot be written.
function kernelCommit(at: U64, length: U64) -> Result<Void, TesseraError> {
    var answer = madvise(RawPtr(at), length, Advice.populateWrite)
    if failedWith(answer, .BadAddress) || failedWith(answer, .Invalid) {
        answer = madvise(RawPtr(at), length, Advice.populateRead)
    }
    return answerStatus(answer)
}

// Releases the range's pages (`MADV_DONTNEED`, 4).
function kernelDecommit(at: U64, length: U64) -> Result<Void, TesseraError> {
    return answerStatus(madvise(RawPtr(at), length, Advice.dontNeed))
}

// Releases the backing's pages in a range, which then read as zero:
// `FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE`.
function kernelDiscardBacking(
    backing: Number,
    offset: U64,
    length: U64
) -> Result<Void, TesseraError> {
    return answerStatus(
        fallocate(backing, FallocateMode.punchHole | FallocateMode.keepSize, offset, length)
    )
}

// Resident bytes in the range, from `mincore`.
function kernelResidentBytes(at: U64, length: U64) -> Result<U64, TesseraError> {
    let page = kernelPageSize()
    let pages = trunc(length / page)
    let vectorBytes = zeroedBlock(count: pages + 1, alignment: 16)
    let vector = vectorBytes.pointer()
    let answer = mincore(RawPtr(at), length, vector)
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    var resident = U64(0)
    for index in 0..pages {
        if (heapLoad<U8>(vector, index) & U8(1)) != U8(0) { resident += page }
    }
    return .Ok(resident)
}

// `length` bytes of the backing mapped read-write and shared, anywhere.
function kernelMapShared(backing: Number, length: U64) -> Result<RawPtr, TesseraError> {
    let answer = mmap(
        nullPointer(),
        length,
        ProtectionFlag.read | ProtectionFlag.write,
        MapFlag.shared,
        backing,
        U64(0)
    )
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    return .Ok(RawPtr(answer))
}

// One read or write at `offset`, as much as the kernel takes now; a
// transfer that would wait, or was interrupted, is `ShouldWait`.
function kernelTransferAt(
    backing: Number,
    write: Bool,
    buffer: RawPtr,
    length: U64,
    offset: U64
) -> Result<U64, TesseraError> {
    var answer = 0
    if write {
        answer = pwrite(backing, buffer, length, offset)
    } else {
        answer = pread(backing, buffer, length, offset)
    }
    if answerFailed(answer) {
        if failedWith(answer, .Again) || failedWith(answer, .Interrupted) {
            return .Error(failure(.ShouldWait))
        }
        return .Error(errnoFailure(answerErrno(answer)))
    }
    return .Ok(U64(answer))
}

// `length` bytes of the backing mapped read-only and shared, anywhere.
function kernelMapReadOnly(backing: Number, length: U64) -> Result<RawPtr, TesseraError> {
    let answer = mmap(nullPointer(), length, ProtectionFlag.read, MapFlag.shared, backing, U64(0))
    if answerFailed(answer) { return .Error(errnoFailure(answerErrno(answer))) }
    return .Ok(RawPtr(answer))
}
