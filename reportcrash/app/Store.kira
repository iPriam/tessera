//! Keeping crash reports on the data volume: their names, their system log tail and pruning the oldest.
import Foundation
import LibTessera

// Where reports are kept, and the system log lines they quote.

/// Where crash reports are kept on the data volume, and how many are kept.
namespace ReportStore {
    let directory: String = "/" + SystemDirectory.diagnosticReports
    let suffix: String = ".crash"
    // The most reports kept; the oldest go first.
    let kept: Number = 64
}

/// How long the report waits for the system log to finish writing.
namespace ReportTiming {
    let relayMillis: Number = 200
}

/// How much of the system log's tail a report takes.
namespace SystemLogTail {
    let path: String = "/" + SystemDirectory.systemLogs + "/system.log"
    // How much of the log's end is read, and how many of its lines kept.
    let bytes: Number = 262144
    let lines: Number = 40
    // `2026-10-14 16:32:01.250 `: the time each line starts with.
    let stampBytes: Number = 24
}

/// A line of the system log, with the time it was written.
struct StampedLine {
    let stamp: String
    let order: Number
    let text: String
}

/// Why the oldest reports could not be removed.
enum ReportPruneFailure {
    Listing(FileFailure)
    Removal(FileFailure)
}

/// Why a report could not be kept.
enum ReportStoreFailure {
    File(FileFailure)
    Pruning(ReportPruneFailure)
}

/// The text a report store failure is shown as.
function reportStoreFailureText(failure: borrow ReportStoreFailure) -> String {
    return match failure {
        File(reason) -> traceText(reason)
        Pruning(pruneFailure) -> match pruneFailure {
            Listing(reason) -> traceText(reason)
            Removal(reason) -> traceText(reason)
        }
    }
}

/// Keeps the report's text as a file, removes the oldest reports past the limit, and answers the path written, or why it could not be kept.
function storeReport(
    name: borrow String,
    crashed: Number,
    report: borrow String
) -> Result<String, ReportStoreFailure> {
    if !isDirectory(ReportStore.directory) {
        match makeDirectory(ReportStore.directory) {
            Ok -> {}
            Error(failed) -> return .Error(.File(failed))
        }
    }
    let base = "\(ReportStore.directory)/\(fileSafe(name))-\(fileStamp(crashed))"
    var path = base + ReportStore.suffix
    var tries = 1
    while pathExists(path) {
        tries += 1
        path = "\(base)-\(tries)\(ReportStore.suffix)"
    }
    let written = path + ".partial"
    match writeFile(written, report) {
        Ok -> {}
        Error(failed) -> return .Error(.File(failed))
    }
    match renamePath(written, path) {
        Ok -> {}
        Error(failed) -> return .Error(.File(failed))
    }
    match pruneReports() {
        Ok -> {}
        Error(failed) -> return .Error(.Pruning(failed))
    }
    return .Ok(path)
}

/// Removes the oldest reports past the limit; they sort oldest first, since the file's name holds its time.
function pruneReports() -> Result<Void, ReportPruneFailure> {
    let listing = match listDirectory(ReportStore.directory) {
        Ok(value) -> value
        Error(failed) -> return .Error(.Listing(failed))
    }
    var reports: [String] = []
    for index in 0..listing.count() {
        match listing.entry(index) {
            Some(entry) -> {
                if entry.endsWith(ReportStore.suffix) { reports.append(entry) }
            }
            // An entry that went since the listing was made is not a report.
            None -> {}
        }
    }
    if reports.count <= ReportStore.kept { return .Ok }
    let sorted = reports.sorted(
        { left, right in return textBefore(reportStampOf(left), reportStampOf(right)) }
    )
    for index in 0..sorted.count - ReportStore.kept {
        match removePath("\(ReportStore.directory)/\(sorted[index])") {
            Ok -> {}
            Error(failed) -> return .Error(.Removal(failed))
        }
    }
    return .Ok
}

/// The time a report's file name holds, as `2026-10-19-113001`, from `name-2026-10-19-113001.crash` or with a `-2`.
function reportStampOf(file: borrow String) -> String {
    let parts = file.substring(0, file.count - ReportStore.suffix.count).split("-")
    if parts.count < 5 { return copy file }
    for index in 0..parts.count - 3 {
        if parts[index].count == 4 && parts[index + 3].count == 6 {
            var pieces: [String] = []
            for position in index..parts.count { pieces.append(copy parts[position]) }
            return joined(pieces, "-")
        }
    }
    return copy file
}

/// A name with nothing a path would read as a separator.
function fileSafe(name: borrow String) -> String {
    let safe = name.split("/")
    let joinedName = joined(safe, "_")
    return joinedName.isEmpty() ? "unknown" : joinedName
}

/// The last lines of the system log before the crash, for the process that crashed; none when there is no log.
function lastLines(capture: borrow CrashCapture, crashed: Number) -> [String] {
    let size = try fileSize(SystemLogTail.path) otherwise return []
    let start = size > SystemLogTail.bytes ? size - SystemLogTail.bytes : 0
    let bytes = try readFileRange(SystemLogTail.path, start, size - start) otherwise return []
    let text = try textFromBytes(bytes) otherwise return []
    let launched = logStampOf(launchMillis(capture, crashed) - 1000)
    var sources = [copy capture.name]
    let program = lastPathPart(capture.path)
    if !program.isEmpty() && program != capture.name { sources.append(program) }
    // Output and errors reach the log apart, so the lines are put back in
    // the order of their times, keeping the log's order between equal ones.
    var stamped: [StampedLine] = []
    for line in text.split("\n") {
        if line.count <= SystemLogTail.stampBytes { continue }
        let stamp = line.substring(0, SystemLogTail.stampBytes - 1)
        if textBefore(stamp, launched) { continue }
        let rest = line.substring(SystemLogTail.stampBytes, line.count)
        match textAfterSource(rest, sources) {
            Some(lineText) -> stamped.append(
                StampedLine { stamp: stamp, order: stamped.count, text: lineText }
            )
            // A line the log wrote for some other program.
            None -> {}
        }
    }
    let ordered = stamped.sorted(
        { left, right in
            if left.stamp != right.stamp { return textBefore(left.stamp, right.stamp) }
            return left.order < right.order
        }
    )
    var found: [String] = []
    for line in ordered { found.append(copy line.text) }
    if found.count <= SystemLogTail.lines { return found }
    var kept: [String] = []
    for index in found.count - SystemLogTail.lines..found.count { kept.append(copy found[index]) }
    return kept
}

/// The text after one of the log's source names; none when it names none of them.
function textAfterSource(rest: borrow String, sources: borrow [String]) -> String? {
    for source in sources {
        if rest.startsWith(source + ": ") {
            return .Some(rest.substring(source.count + 2, rest.count))
        }
    }
    return .None
}

/// The last part of `path`, after its final slash.
function lastPathPart(path: borrow String) -> String {
    let parts = path.split("/")
    return parts.count == 0 ? "" : copy parts[parts.count - 1]
}

/// When the crashed process was launched, in milliseconds since 1970, from the capture.
function launchMillis(capture: borrow CrashCapture, crashed: Number) -> Number {
    if capture.uptime <= 0 || capture.startedAfterBoot > capture.uptime { return crashed }
    return crashed - (capture.uptime - capture.startedAfterBoot) * 1000
}

/// Whether `left` sorts before `right`, byte by byte.
function textBefore(left: borrow String, right: borrow String) -> Bool {
    let shorter = left.count < right.count ? left.count : right.count
    for index in 0..shorter {
        let leftByte = left.charAt(index)
        let rightByte = right.charAt(index)
        if leftByte != rightByte { return leftByte < rightByte }
    }
    return left.count < right.count
}
