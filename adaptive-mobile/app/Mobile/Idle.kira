//! Adaptive Mobile's idle behaviour: the display's sleep time, the idle times the Settings app keeps, and the
//! start-up choice between the lock screen and an unlocked session.
import Foundation
import ArgumentParser
import LibTessera
import PlatformKit
import TesseraDisplayClient

// The output dims and blanks for want of input on the times this platform
// sets (roadmap/11-adaptive-desktop.md, "Idle"): two minutes, what Auto-Lock
// holds, or what the platform was started with, and the lock screen closes
// when it blanks.

/// The platform's command line: `--display-sleep` sets the seconds without
/// input before the output blanks, as `pmset displaysleep` sets a Mac's.
function platformCommand() -> CommandRouter {
    return CommandRouter {
        root: Command {
            configuration: CommandConfiguration {
                name: "adaptive-mobile",
                abstract: "The Adaptive Mobile platform"
            },
            arguments: [option(
                name: "display-sleep",
                help: "Seconds without input before the output blanks"
            ).whole().placeholder("SECONDS").defaulting(String(IdlePolicy.mobileBlank)), flag(
                name: "unlocked",
                help: "Start with the lock screen open, as when switched in"
            )]
        }
    }
}

/// The seconds without input the output blanks after: what the platform was
/// started with, else what Settings' Auto-Lock holds, else two minutes.
function displaySleep() -> Number {
    let router = platformCommand()
    let tokens = commandLineArguments()
    if !tokens.contains("--display-sleep") {
        match storedDisplaySleep(settingValue(IdleSetting.key, "")) {
            Some(seconds) -> return seconds
            None -> {}
        }
    }
    return match router.parse(tokens) {
        Ok(parsed) -> parsed.requiredNumber("display-sleep")
        Error(error) -> {
            router.explain(error, tokens)
            IdlePolicy.mobileBlank
        }
    }
}

/// Tells the display server when the output dims and blanks.
function keepIdleTimes(channel: Handle) {
    let times = idleTimes(displaySleep())
    let idle = DisplayIdle { dim: UNumber(times.dim), blank: UNumber(times.blank) }
    match sendSetIdle(channel, move idle) {
        Ok -> log info("the output blanks for want of input", dim: times.dim, blank: times.blank)
        Error(failed) -> log warn("could not set the idle times", error: errorName(failed))
    }
}

/// The output dimmed, blanked or woke. The lock screen closes as it blanks, so
/// it is what the output wakes to.
function idleChanged(mobile: borrow mut Mobile, state: borrow DisplayIdleState) {
    log info("the output changed for want of input", state: displayIdleStateName(state))
    match state {
        Blanked -> lockScreen(mobile)
        Awake, Dimmed -> {}
    }
}

/// Whether the platform starts with the lock screen open: PID 1 starts a
/// platform a person switched to that way, since they are past it already.
function startsUnlocked() -> Bool {
    let router = platformCommand()
    let tokens = commandLineArguments()
    return match router.parse(tokens) {
        Ok(parsed) -> parsed.flag("unlocked")
        Error(error) -> false
    }
}
